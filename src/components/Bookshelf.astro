---
// Hand-authored flat, low-poly bookshelf in the character's desaturated palette.
// The books group is the interaction trigger (data-nav="reading").
---

<div class="bookshelf">
  <svg viewBox="0 0 260 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="书架">
    <!-- Frame -->
    <rect x="8" y="6" width="244" height="348" fill="#cdd2d3" />
    <rect x="8" y="6" width="244" height="348" fill="none" stroke="#aab1b3" stroke-width="4" />
    <!-- Back panel (recessed shade) -->
    <rect x="20" y="18" width="220" height="324" fill="#dadfe0" />
    <!-- Shelves -->
    <rect x="14" y="128" width="232" height="12" fill="#b7bfc0" />
    <rect x="14" y="238" width="232" height="12" fill="#b7bfc0" />

    <!-- Top shelf: books (interaction trigger) -->
    <g class="books" data-nav="reading" role="button" tabindex="0" aria-label="打开阅读">
      <rect x="36" y="52" width="16" height="76" fill="#8b9092" />
      <rect x="54" y="44" width="16" height="84" fill="#adb3b3" />
      <rect x="72" y="60" width="16" height="68" fill="#94231f" />
      <rect x="90" y="48" width="16" height="80" fill="#9ea3a4" />
      <!-- a leaning book -->
      <path d="M112 128 L110 58 L124 62 L128 128 Z" fill="#888e8f" />
    </g>

    <!-- Top shelf: potted plant (the one touch of muted green) -->
    <g class="plant">
      <path d="M196 88 C 176 70 182 52 196 40 C 204 56 206 72 196 90 Z" fill="#879a83" />
      <path d="M196 92 C 214 74 214 54 202 44 C 200 62 200 78 196 92 Z" fill="#96a892" />
      <path d="M182 106 L210 106 L206 128 L186 128 Z" fill="#b7bfc0" />
    </g>

    <!-- Middle shelf: stacked books + a small vase -->
    <g class="stack">
      <rect x="38" y="214" width="70" height="10" fill="#93989a" />
      <rect x="44" y="204" width="60" height="10" fill="#adb3b3" />
      <rect x="50" y="194" width="48" height="10" fill="#878d8e" />
    </g>
    <g class="vase">
      <path d="M196 238 C 184 224 188 206 200 200 C 212 206 216 224 204 238 Z" fill="#c2c8c9" />
      <path d="M200 202 C 197 208 197 214 200 219 C 203 214 203 208 200 202 Z" fill="#a6acad" />
    </g>
  </svg>
</div>

<style>
  .bookshelf {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    filter: drop-shadow(0 8px 12px var(--color-shadow));
  }

  .bookshelf svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .books {
    cursor: pointer;
    transition: transform 0.2s ease;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .books:hover,
  .books:focus-visible {
    transform: translateY(-3px);
    outline: none;
  }
</style>
