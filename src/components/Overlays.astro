---
// Two navigable surfaces, driven by the URL hash so the browser's history
// works natively:
//   #about   -> a small frosted-glass card (clicking the character)
//   #reading -> a full-screen long-form reading space (clicking the books)
// Any [data-nav="x"] element opens #x; [data-close] / Esc / browser Back close.
// Because state lives in location.hash, Back/Forward and deep links just work,
// and refreshing keeps you where you were (safe on static hosting).
//
// Long-form copy is authored as Markdown and rendered via Astro's built-in
// Markdown support: import the .md file, read its frontmatter, drop in <Content/>.
import { Content, frontmatter } from '../articles/finding-breath.md';
---

<!-- ABOUT: repurposed frosted card. Short, personal, self-contained. -->
<div class="about" id="about-view" data-open="false" aria-hidden="true">
  <div class="about__catch" data-close></div>

  <div class="about__frame">
    <section
      class="about__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="about-title"
    >
      <span class="about__accent"></span>
      <header class="about__bar">
        <h2 class="about__title" id="about-title">关于 · About</h2>
        <button class="about__close" type="button" data-close aria-label="关闭">
          <span></span><span></span>
        </button>
      </header>
      <div class="about__body">
        <p>你好，我是海兔。这是一个关于图形、克制与实验的 2.5D 博客。</p>
        <p>
          比起把内容塞进一张卡片，我更想把它做成一个可以走进去的房间。点亮的时钟、
          身后的书架，都是可以点开的入口。
        </p>
        <p class="about__meta">书架里放着可长读的文字 · 时钟走着真实的时间</p>
      </div>
    </section>
  </div>
</div>

<!-- READING: a full, stable reading space. No dismiss-X, only a Back affordance
     and browser navigation, so it never reads as a temporary popup. -->
<div class="reader" id="reading-view" data-open="false" aria-hidden="true">
  <div class="reader__surface">
    <header class="reader__bar">
      <button class="reader__back" type="button" data-close aria-label="返回">
        <span class="reader__arrow"></span>返回
      </button>
      <span class="reader__brand">海兔的博客 · 阅读</span>
    </header>

    <div class="reader__scroll" id="reading-scroll" tabindex="-1">
      <div class="reader__col">
        <nav class="reader__index" aria-label="文章索引">
          <span class="reader__index-label">近期</span>
          <ol>
            <li><a href="#reading">在低面数里寻找呼吸感</a><time>2026 · 07</time></li>
            <li><a href="#reading">当 AI 成为我的绘图搭档</a><time>2026 · 06</time></li>
            <li><a href="#reading">克制，是一种设计的勇气</a><time>2026 · 05</time></li>
          </ol>
        </nav>

        <article class="prose">
          <p class="prose__kicker">{frontmatter.kicker}</p>
          <h1>{frontmatter.title}</h1>
          <p class="prose__meta">{frontmatter.date} · {frontmatter.readingTime}</p>

          <div class="prose__body">
            <Content />
          </div>

          <p class="prose__end">· 完 ·</p>
        </article>
      </div>
    </div>
  </div>
</div>

<style>
  /* ---------- About (frosted card) ---------- */
  .about {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .about[data-open='true'] {
    display: flex;
  }
  .about__catch {
    position: absolute;
    inset: 0;
    background: transparent;
  }
  .about__frame {
    position: relative;
    filter: drop-shadow(0 22px 44px rgba(34, 46, 54, 0.28));
    animation: about-in 0.24s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes about-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .about__panel {
    position: relative;
    width: min(440px, 88vw);
    display: flex;
    flex-direction: column;
    /* Denser frost, higher opacity => far more readable than before. */
    background: rgba(240, 244, 245, 0.82);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 0 0 1px rgba(255, 255, 255, 0.28);
    clip-path: polygon(
      0 20px,
      20px 0,
      100% 0,
      100% calc(100% - 20px),
      calc(100% - 20px) 100%,
      0 100%
    );
  }
  .about__accent {
    position: absolute;
    left: 0;
    top: 20px;
    bottom: 0;
    width: 4px;
    background: var(--color-accent);
  }
  .about__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.15rem 0.85rem 1.35rem;
    border-bottom: 1px solid rgba(45, 51, 56, 0.16);
  }
  .about__title {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--color-text);
  }
  .about__close {
    position: relative;
    width: 20px;
    height: 20px;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
    flex: none;
  }
  .about__close span {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.6px;
    background: var(--color-text-dim);
    transition: background 0.15s ease;
  }
  .about__close span:first-child {
    transform: rotate(45deg);
  }
  .about__close span:last-child {
    transform: rotate(-45deg);
  }
  .about__close:hover span {
    background: var(--color-accent);
  }
  .about__body {
    padding: 1.1rem 1.25rem 1.35rem 1.35rem;
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .about__body p {
    margin: 0 0 0.85rem;
  }
  .about__body p:last-child {
    margin-bottom: 0;
  }
  .about__meta {
    color: var(--color-text-dim);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  /* ---------- Reading (full-screen long-form) ---------- */
  .reader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }
  .reader[data-open='true'] {
    display: block;
  }
  .reader__surface {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    /* Near-opaque, lightly frosted: connected to the scene, but built to read. */
    background: rgba(240, 244, 245, 0.94);
    -webkit-backdrop-filter: blur(34px) saturate(160%);
    backdrop-filter: blur(34px) saturate(160%);
    animation: reader-in 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes reader-in {
    from {
      opacity: 0;
      transform: translateY(2%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .reader__bar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem clamp(1rem, 5vw, 3rem);
    border-bottom: 1px solid rgba(45, 51, 56, 0.12);
    background: linear-gradient(
      to bottom,
      rgba(240, 244, 245, 0.6),
      rgba(240, 244, 245, 0)
    );
  }
  .reader__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: none;
    background: none;
    cursor: pointer;
    padding: 0.35rem 0.1rem;
    font: inherit;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }
  .reader__back:hover {
    color: var(--color-accent);
  }
  /* Back arrow drawn from two sharp bars (no rounded chevrons). */
  .reader__arrow {
    position: relative;
    width: 12px;
    height: 12px;
    flex: none;
  }
  .reader__arrow::before,
  .reader__arrow::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 9px;
    height: 1.6px;
    background: currentColor;
    transform-origin: left center;
  }
  .reader__arrow::before {
    transform: rotate(-135deg);
  }
  .reader__arrow::after {
    transform: rotate(135deg);
  }
  .reader__brand {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
  }
  .reader__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    outline: none;
  }
  .reader__col {
    max-width: 660px;
    margin: 0 auto;
    padding: clamp(2rem, 6vh, 4.5rem) clamp(1.25rem, 5vw, 2rem) 6rem;
  }

  /* Index of pieces, implying a collection to read through. */
  .reader__index {
    margin-bottom: clamp(2.5rem, 7vh, 4rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(45, 51, 56, 0.12);
  }
  .reader__index-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 0.75rem;
  }
  .reader__index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reader__index li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
  }
  .reader__index a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.98rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .reader__index a:hover {
    border-bottom-color: var(--color-accent);
  }
  .reader__index time {
    flex: none;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    font-variant-numeric: tabular-nums;
  }

  /* Long-form typography */
  .prose {
    color: var(--color-text);
  }
  .prose__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }
  .prose h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0 0 0.6rem;
  }
  .prose__meta {
    color: var(--color-text-dim);
    font-size: 0.85rem;
    margin: 0 0 2rem;
  }
  /* Markdown-rendered body: elements come from <Content/> and carry no scope
     hash, so they're targeted with :global under the .prose__body wrapper. */
  .prose__body :global(h2) {
    font-size: 1.2rem;
    font-weight: 620;
    margin: 2.4rem 0 0.7rem;
  }
  .prose__body :global(p) {
    font-size: 1.02rem;
    line-height: 1.85;
    margin: 0 0 1.3rem;
    color: #3a4147;
  }
  .prose__body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.4rem 0 0.4rem 1.4rem;
    border-left: 3px solid var(--color-accent);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .prose__end {
    margin-top: 3rem;
    text-align: center;
    letter-spacing: 0.4em;
    color: var(--color-text-dim);
  }

  @media (prefers-reduced-motion: reduce) {
    .about__frame,
    .reader__surface {
      animation: none;
    }
  }
</style>

<script>
  // The set of navigable views. A hash of '#<view>' opens the matching surface.
  const VIEWS = ['about', 'reading'] as const;
  type View = (typeof VIEWS)[number];

  const surfaces: Record<View, HTMLElement | null> = {
    about: document.getElementById('about-view'),
    reading: document.getElementById('reading-view'),
  };
  const readingScroll = document.getElementById('reading-scroll');

  function currentView(): View | null {
    const key = location.hash.replace(/^#/, '');
    return (VIEWS as readonly string[]).includes(key) ? (key as View) : null;
  }

  // Reflect the URL into the DOM. Called on load and on every hash change,
  // so Back/Forward/deep-links all resolve through this single path.
  function render() {
    const active = currentView();
    for (const view of VIEWS) {
      const el = surfaces[view];
      if (!el) continue;
      const open = view === active;
      el.dataset.open = String(open);
      el.setAttribute('aria-hidden', String(!open));
    }
    // A fresh reading session should start at the top.
    if (active === 'reading' && readingScroll) {
      readingScroll.scrollTop = 0;
      readingScroll.focus({ preventScroll: true });
    }
  }

  function openView(view: string) {
    if (location.hash === `#${view}`) return; // avoid duplicate history entries
    location.hash = `#${view}`; // pushes a history entry -> Back will close it
  }

  function closeView() {
    if (!location.hash) return;
    // Prefer going Back so Forward can re-open; fall back to clearing the hash
    // for deep links that have no prior in-app entry.
    if (history.length > 1) {
      history.back();
    } else {
      history.replaceState(null, '', location.pathname + location.search);
      render();
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('[data-nav]');
    if (trigger) {
      e.preventDefault();
      openView(trigger.getAttribute('data-nav') as string);
      return;
    }
    if (target.closest('[data-close]')) {
      e.preventDefault();
      closeView();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentView()) {
      closeView();
      return;
    }
    // Enter/Space activates a focused [data-nav] trigger (e.g. the character).
    if (e.key === 'Enter' || e.key === ' ') {
      const el = document.activeElement as HTMLElement | null;
      const view = el?.closest('[data-nav]')?.getAttribute('data-nav');
      if (view) {
        e.preventDefault();
        openView(view);
      }
    }
  });

  window.addEventListener('hashchange', render);
  render();
</script>
