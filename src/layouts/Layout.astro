---
interface Props {
  title?: string;
  description?: string;
}

const SITE = 'https://maribbit.com';
const {
  title = "Maribbit's Blog | 海兔的博客",
  description = "Maribbit's blog — a quiet corner of the internet. Handcrafted scenes built with SVG and low-poly graphics: a room, a window over the sea, a character that breathes.",
} = Astro.props;
const pageUrl = SITE + Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="SVG, low-poly, 3D illusion, 2.5D, web graphics, Astro, creative coding, handcrafted web, minimalist design, 低多边形, 图形博客" />
    <meta name="author" content="Maribbit" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#E8EBEC" />
    <link rel="canonical" href={pageUrl} />

    <!-- Favicon: static SVG fallback, then upgraded to a live-ticking
         clock by the script at the end of <body>. -->
    <link rel="icon" id="favicon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Warm the connection to Apple Music so the embed player
         (loaded only when the music overlay opens) starts faster. -->
    <link rel="preconnect" href="https://embed.music.apple.com" crossorigin />
    <link rel="dns-prefetch" href="https://embed.music.apple.com" />
    <link rel="preconnect" href="https://music.apple.com" />
    <link rel="dns-prefetch" href="https://music.apple.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maribbit's Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={SITE + '/og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + '/og.jpg'} />
  </head>
  <body>
    <slot />
    <script is:inline>
      /* Live-ticking clock favicon.
         Draws the same hexagonal clock as the wall clock onto a small
         canvas once per minute and swaps it into <link id="favicon">,
         so the browser tab shows the time. Falls back gracefully to the
         static favicon.svg when canvas isn't available. No second hand,
         and repaints are aligned to the minute boundary so the canvas
         only redraws when the time actually changes. */
      (function () {
        var link = document.getElementById('favicon');
        if (!link) return;
        var SIZE = 64, CX = 32, CY = 32, R = 28, TAU = Math.PI * 2;
        var c = document.createElement('canvas');
        c.width = c.height = SIZE;
        var ctx = c.getContext('2d');
        if (!ctx) return;

        function hex() {
          ctx.beginPath();
          for (var i = 0; i < 6; i++) {
            var a = (Math.PI / 180) * (60 * i - 30);
            var x = CX + R * Math.cos(a);
            var y = CY + R * Math.sin(a);
            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
          }
          ctx.closePath();
        }
        function tickMark(angle) {
          ctx.save();
          ctx.translate(CX, CY);
          ctx.rotate(angle);
          ctx.fillStyle = '#79838a';
          ctx.fillRect(-1.2, -(R - 4), 2.4, 5);
          ctx.restore();
        }
        function hand(angle, len, w, color) {
          ctx.save();
          ctx.translate(CX, CY);
          ctx.rotate(angle);
          ctx.fillStyle = color;
          ctx.fillRect(-w / 2, -len, w, len);
          ctx.restore();
        }

        function draw() {
          ctx.clearRect(0, 0, SIZE, SIZE);
          hex();
          ctx.fillStyle = '#eef2f3';
          ctx.fill();
          ctx.lineWidth = 2.5;
          ctx.strokeStyle = '#c2cacd';
          ctx.stroke();

          for (var i = 0; i < 4; i++) tickMark((i * TAU) / 4);

          var now = new Date();
          var m = now.getMinutes();
          var h = (now.getHours() % 12) + m / 60;

          hand((h / 12) * TAU, 11, 3.4, '#2d3338');
          hand((m / 60) * TAU, 16, 2.4, '#2d3338');

          ctx.save();
          ctx.translate(CX, CY);
          ctx.rotate(TAU / 8);
          ctx.fillStyle = '#2d3338';
          ctx.fillRect(-2.6, -2.6, 5.2, 5.2);
          ctx.restore();

          link.type = 'image/png';
          link.href = c.toDataURL('image/png');
        }

        // Draw now, then align future repaints to the minute boundary so
        // the favicon only redraws when the time actually changes.
        draw();
        setTimeout(function align() {
          draw();
          setInterval(draw, 60000);
        }, 60000 - (Date.now() % 60000));
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Cool, clean, airy palette. The character is desaturated cool-gray, so the
       room reads fresher on a neutral blue-gray rather than a warm beige. */
    --color-bg: #e8ebec; /* wall */
    --color-floor: #dde5e6; /* ground band */
    --color-line: #c2cacd;
    --color-text: #2d3338;
    --color-text-dim: #79838a;
    --color-accent: #94231f; /* single warm accent — the eye color */
    --color-surface: #eef2f3; /* frosted window base */
    --color-shadow: rgba(34, 46, 54, 0.13);

    /* ── Maribbit Paper ─────────────────────────────────────────────
       Shared material for content carriers (About card, Reading page,
       and any future sheet). Cool, restrained translucency that sits
       on the wall rather than floating as iOS glass. */
    /* More open translucency so the sea / room can breathe through. */
    --paper-bg: rgba(237, 241, 242, 0.52);
    --paper-blur: 12px;
    --paper-saturate: 108%;
    --paper-edge: rgba(45, 51, 56, 0.09);
    --paper-hairline: rgba(45, 51, 56, 0.08);
    --paper-scrim: rgba(34, 46, 54, 0.04);
    --paper-ink: #3a4147;
    --paper-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 16px 36px rgba(34, 46, 54, 0.1);

    /* Type scale shared by paper surfaces */
    --paper-label: 0.68rem;
    --paper-label-track: 0.2em;
    --paper-title-card: 1.05rem;
    --paper-body: 0.98rem;
    --paper-body-lh: 1.8;

    /* Spacing — content-centric, not chrome-centric */
    --paper-pad-x-card: 1.45rem;
    --paper-pad-y-card: 1.25rem;
    --paper-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
      'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>