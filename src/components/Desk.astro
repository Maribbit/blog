---
// Desk — SVG <path> faces generated at runtime by JS.
//
// 14 faces: 5 top, 5 front, 4 extension (full-width forward platform).
// viewBox 100×100, preserveAspectRatio="none".
//
// Geometry (viewBox y):
//   0─17  : upper-left / upper-right top faces
//   0─33  : left / right ramps
//   17─100: front faces (vertical drops)
//   33─49 : extension platform (full-width, perspective-widened)
//   49─100: extension front face
//
// z-index 25 (above character 20) so desk occludes the lower body.
import CoffeeCup from './CoffeeCup.astro';
import Headphone from './Headphone.astro';
import Pedestal from './Pedestal.astro';
import Notebook from './Notebook.astro';
---

<div class="desk">
  <svg
    class="desk__svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    overflow="visible"
    shape-rendering="geometricPrecision"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- All faces generated as <path> by JS (no clip-path, no seams) -->
  </svg>

  <!-- ICP filing number — bottom center of the desk front face.
       HTML overlay (not SVG <text>) so it isn't distorted by the
       desk's preserveAspectRatio="none" stretch. -->
  <a
    class="desk__icp"
    href="https://beian.miit.gov.cn/"
    target="_blank"
    rel="noopener"
  >沪ICP备2025148475号-1</a>

  <CoffeeCup />
  <Pedestal />
  <Headphone />
  <Notebook />
</div>

<style>
  .desk {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--desk-w);
    height: calc(var(--char-h) * 0.42);
    transform: translateX(-50%);
    z-index: 25;
    overflow: visible;
  }

  .desk__svg {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    overflow: visible;
  }

  /* ICP filing number — small, quiet, sits on the extension front
     face (the desk's lowest, front-most surface). */
  .desk__icp {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    z-index: 2;
    /* Sized in scene units (--cm, height-driven) like every other prop,
       NOT viewport width — the desk's pixel size doesn't change when
       the window is stretched horizontally, so neither should the text. */
    font-size: calc(2.6 * var(--cm));
    letter-spacing: 0.1em;
    color: rgba(45, 51, 56, 0.42);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0.85;
    transition: color 0.2s ease, opacity 0.2s ease;
    cursor: pointer;
  }

  .desk__icp:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  /* All faces rendered as SVG <path> elements by JS below. */
</style>

<script>
  import { getStageGeom, narrowFrac } from '../utils/perspective';

  function applyDeskClipPaths(): void {
    const desk = document.querySelector<HTMLElement>('.desk');
    if (!desk) return;

    const g = getStageGeom();
    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = desk.querySelector('svg')!;

    /* Perspective narrow fractions */
    const nf  = narrowFrac(g.deskY17 - g.vpY, g.deskTopY - g.vpY);
    const nmf = narrowFrac(g.deskY33 - g.vpY, g.deskY17 - g.vpY);
    const extNf = narrowFrac(g.deskY49 - g.vpY, g.deskY33 - g.vpY);
    const fullWiden = 50 * extNf / (1 - extNf);
    const NF = nf, NMF = nmf, FW = fullWiden;

    /* Color map */
    const C = {
      top:      '#d2d9da',
      ramp:     '#bfcbcc',
      front:    '#a8b5b6',
      extTop:   '#d2d9da',
      extFront: '#a8b5b6',
    };

    /* Tiny overlap to seal sub-pixel anti-aliasing gaps between
       adjacent faces (~0.24px at 1200px desk width). */
    const E = 0.02;

    /* Tray front x-boundary (ramp inner edge). Lower value ⇒ steeper
       ramps + wider lower-middle tray. Was 38 → 36. */
    const TR = 36;

    /* definition: { id, d, fill } */
    const faceDefs = [
      /* ─── Top faces (bottom edges pushed down by E) ─── */
      { id: 'df-upper-left', fill: C.top,
        d: `M ${50*NF} 0 L ${30+20*NF} 0 L 30 ${17+E} L 0 ${17+E} Z` },
      { id: 'df-left-ramp', fill: C.ramp,
        d: `M ${30+20*NF} 0 L ${TR+(50-TR)*NMF} ${17+E} L ${TR} ${33+E} L 30 ${17+E} Z` },
      { id: 'df-lower-mid', fill: C.top,
        d: `M ${TR} ${33+E} L ${100-TR} ${33+E} L ${100-TR-(50-TR)*NMF} ${17+E} L ${TR+(50-TR)*NMF} ${17+E} Z` },
      { id: 'df-right-ramp', fill: C.ramp,
        d: `M ${100-TR-(50-TR)*NMF} ${17+E} L ${70-20*NF} 0 L 70 ${17+E} L ${100-TR} ${33+E} Z` },
      { id: 'df-upper-right', fill: C.top,
        d: `M ${70-20*NF} 0 L ${100-50*NF} 0 L 100 ${17+E} L 70 ${17+E} Z` },

      /* ─── Front faces (top edges pushed up by E) ─── */
      { id: 'df-front-left', fill: C.front,
        d: `M 0 ${17-E} L 30 ${17-E} L 30 100 L 0 100 Z` },
      { id: 'df-front-left-ramp', fill: C.front,
        d: `M 30 ${17-E} L ${TR} ${33-E} L ${TR} 100 L 30 100 Z` },
      { id: 'df-front-mid', fill: C.front,
        d: `M ${TR} ${33-E} L ${100-TR} ${33-E} L ${100-TR} 100 L ${TR} 100 Z` },
      { id: 'df-front-right-ramp', fill: C.front,
        d: `M ${100-TR} ${33-E} L 70 ${17-E} L 70 100 L ${100-TR} 100 Z` },
      { id: 'df-front-right', fill: C.front,
        d: `M 70 ${17-E} L 100 ${17-E} L 100 100 L 70 100 Z` },

      /* ─── Extension faces ─── */
      { id: 'df-ext-left', fill: C.extFront,
        d: `M ${-FW} ${49+E} L 0 ${33-E} L 0 100 L ${-FW} 100 Z` },
      { id: 'df-ext-right', fill: C.extFront,
        d: `M 100 ${33-E} L ${100+FW} ${49+E} L ${100+FW} 100 L 100 100 Z` },
      { id: 'df-ext-front', fill: C.extFront,
        d: `M ${-FW} ${49-E} L ${100+FW} ${49-E} L ${100+FW} 100 L ${-FW} 100 Z` },
      { id: 'df-ext-top', fill: C.extTop,
        d: `M ${-FW} ${49+E} L ${100+FW} ${49+E} L 100 ${33-E} L 0 ${33-E} Z` },
    ];

    /* Create or update each fill-only <path>. */
    for (const f of faceDefs) {
      let el = svg.querySelector<SVGPathElement>('#' + f.id);
      if (!el) {
        el = document.createElementNS(svgNS, 'path');
        el.id = f.id;
        el.setAttribute('stroke', 'none');
        svg.appendChild(el);
      }
      el.setAttribute('d', f.d);
      el.setAttribute('fill', f.fill);
    }
  }

  requestAnimationFrame(() => { applyDeskClipPaths(); });
  window.addEventListener('resize', applyDeskClipPaths);
</script>
