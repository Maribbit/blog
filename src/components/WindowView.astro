---
// WindowView — the scene visible through the open window.
//
// Separate from the frame so the scenery can be swapped independently
// (day/night, different locations, animations, etc).
//
// The viewBox matches the glass opening of the frame: 1698 x 835.
// The frame component renders this view behind itself, sized to fit the
// opening exactly.
//
// The scene is a stack of layers, drawn bottom-up so each upper layer
// paints over the one below it. Every layer fills the full viewBox
// (or as much as it needs) so the layers STACK, not tile — there is
// no horizontal dividing line between them, and any uncovered region
// shows the layer below.
//   1. Sky     — vertical gradient, full viewBox
//   2. Clouds  — soft white shapes floating in the sky
//   3. Ocean   — low-poly dynamic sea along the lower portion
//   4. Islands — two distant silhouettes straddling the horizon
//   5. Lighthouse — small structure on the right island
//
// Sea and cloud logic are split into src/utils/sea.ts and
// src/utils/clouds.ts for independent maintenance.
---

<div class="window-view" aria-hidden="true">
  <svg
    class="window-view__svg"
    viewBox="0 0 1698 835"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Sky gradient -->
      <linearGradient id="SkyGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d5d7db" />
        <stop offset="1" stop-color="#e6e6e6" />
      </linearGradient>

      <!-- Base sea gradient (stops filled by src/utils/sea.ts) -->
      <linearGradient id="BaseSeaGradient" x1="0" y1="0" x2="0" y2="1">
        <stop id="grad-stop-far" offset="0%" />
        <stop id="grad-stop-mid" offset="5%" />
        <stop id="grad-stop-near" offset="100%" />
      </linearGradient>
    </defs>

    <!-- Sky: fills entire viewBox -->
    <rect
      id="Sky"
      x="0"
      y="0"
      width="1698"
      height="835"
      fill="url(#SkyGradient)"
    />

    <!-- Base sea gradient rect (re-positioned by sea.ts) -->
    <rect
      id="base-sea-rect"
      x="0"
      y="452"
      width="1698"
      height="383"
      fill="url(#BaseSeaGradient)"
    />

    <!-- Clouds container -->
    <g id="cloud-layer"></g>

    <!-- Ocean layers container -->
    <g id="sea-layers"></g>
  </svg>
</div>

<style>
  .window-view {
    width: 100%;
    height: 100%;
    display: block;
  }

  .window-view__svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
  }
</style>

<script>
  import { getStageGeom, vpYtoWindowViewY } from '../utils/perspective';
  import { buildOcean } from '../utils/sea';
  import { buildClouds } from '../utils/clouds';

  const VIEW_W = 1698;
  const VIEW_H = 835;

  /* ─── Vanishing-point driven sea horizon ─── */
  let seaTopY = 452;
  try {
    const geom = getStageGeom();
    seaTopY = vpYtoWindowViewY(geom.vpY, geom);
  } catch { /* stage not ready — use fallback */ }

  /* ─── Build sea ─── */
  const seaContainer = document.getElementById('sea-layers') as unknown as SVGGElement;
  const { animate: seaAnimate } = seaContainer
    ? buildOcean(seaContainer, { viewWidth: VIEW_W, viewHeight: VIEW_H, seaTopY })
    : { animate: () => {} };

  /* ─── Build clouds ─── */
  const cloudContainer = document.getElementById('cloud-layer') as unknown as SVGGElement;
  const { update: cloudUpdate } = cloudContainer
    ? buildClouds(cloudContainer, { viewWidth: VIEW_W, viewHeight: VIEW_H })
    : { update: () => {} };

  /* ─── Shared animation loop ─── */
  let time = 0;
  function animate(): void {
    time += 0.02;
    seaAnimate(time);
    cloudUpdate();
    requestAnimationFrame(animate);
  }
  requestAnimationFrame(animate);
</script>
