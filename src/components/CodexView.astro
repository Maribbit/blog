---
// Codex (图鉴) — the notebook's collection of ships & aircraft.
//
// Rendered statically from the manifest at build time: no search, no
// filters — just a grid of cards. Descriptions are bilingual (zh/en)
// with a one-tap switch in the footer; pure CSS show/hide, no re-render.
import {
  CODEX_ENTRIES,
  CODEX_RARITY_LABELS,
  CODEX_RARITY_LABELS_EN,
} from '../utils/codex';
---

<div class="paper paper--codex" id="codex-view" data-open="false" aria-hidden="true">
  <div class="paper__veil paper__veil--codex" aria-hidden="true"></div>

  <div class="paper__scroll" id="codex-scroll" tabindex="-1">
    <div class="paper__codex-container">
      <div class="paper__codex-grid">
        {CODEX_ENTRIES.map((e) => (
          <article class="paper__codex-card">
            <div class="paper__codex-card-media">
              <span
                class={`paper__codex-badge paper__codex-badge--${e.rarity}`}
                aria-hidden="true"
              >
                <span data-rarity="zh">{CODEX_RARITY_LABELS[e.rarity]}</span>
                <span data-rarity="en" hidden>{CODEX_RARITY_LABELS_EN[e.rarity]}</span>
              </span>
              <Fragment set:html={e.svg} />
            </div>
            <div class="paper__codex-card-body">
              <h3 class="paper__codex-card-name">
                <span data-name="zh">{e.name}</span>
                <span data-name="en" hidden>{e.nameEn}</span>
              </h3>
              <span class="paper__codex-card-en">
                <span data-name-sub="zh">{e.nameEn}</span>
                <span data-name-sub="en" hidden>{e.name}</span>
              </span>
              <p class="paper__codex-card-desc">
                <span data-desc="zh">{e.desc}</span>
                <span data-desc="en" hidden>{e.descEn}</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Fixed bottom footer — full-width bar. Title sits in the center
       with the close button on its right and the lang toggle mirroring
       it on the left — a symmetric pair of circular glass controls.
       Both controls are pinned symmetrically about the footer's CENTER
       (not the title), so the zh/en switch — which changes the title's
       width — never nudges the buttons. -->
  <footer class="paper__codex-footer">
    <div class="paper__codex-footer-inner">
      <button class="paper__codex-lang" type="button" data-lang-toggle aria-label="切换描述语言" title="中文 / EN">
        <span class="paper__codex-lang-item" data-lang-item="zh">中文</span>
        <span class="paper__codex-lang-item" data-lang-item="en">EN</span>
      </button>
      <div class="paper__codex-footer-title">
        <h2 class="paper__title" id="codex-title">
          <span data-name="zh">图鉴</span>
          <span data-name="en" hidden>Codex</span>
        </h2>
        <span class="paper__codex-footer-sub">
          <span data-name-sub="zh">Codex</span>
          <span data-name-sub="en" hidden>图鉴</span>
        </span>
      </div>
      <button class="paper__close" type="button" data-close aria-label="关闭">
        <span class="paper__x" aria-hidden="true"></span>
      </button>
    </div>
  </footer>
</div>

<style>
  .paper--codex {
    display: none;
  }
  .paper--codex[data-open='true'] {
    display: flex;
    flex-direction: column;
  }
  .paper__veil--codex {
    position: absolute;
    inset: 0;
    pointer-events: auto;
    background:
      radial-gradient(
        ellipse 80% 70% at 50% 40%,
        rgba(237, 241, 242, 0.78) 0%,
        rgba(237, 241, 242, 0.42) 55%,
        rgba(237, 241, 242, 0.12) 100%
      );
    -webkit-backdrop-filter: blur(14px) saturate(108%);
    backdrop-filter: blur(14px) saturate(108%);
  }
  .paper__codex-container {
    position: relative;
    width: min(880px, 94%);
    /* margin: auto centers in the flex scroll; collapses to 0 when
       the content overflows, so the sheet scrolls from the top.
       Generous bottom padding keeps the last cards clear of the
       fixed bottom dock. */
    margin: auto;
    padding: 2.4rem 0 7rem;
  }

  /* ──────────── Bottom footer (full-width, title + close centered) ── */
  /* Fixed to the viewport bottom edge — the scroll layer only covers
     the area above it, so cards scroll behind cleanly. */
  .paper__codex-footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 0.7rem 1rem calc(0.7rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--paper-edge);
    background: rgba(237, 241, 242, 0.78);
    -webkit-backdrop-filter: blur(18px) saturate(112%);
    backdrop-filter: blur(18px) saturate(112%);
  }
  .paper__codex-footer-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    max-width: 880px;
    margin: 0 auto;
  }
  /* Both circular controls are taken out of flow and pinned
     symmetrically about the footer's center. The centered title floats
     between them, so when its width changes with the zh/en switch
     (图鉴 ⇄ Codex) the buttons stay exactly where they are. Inner edge
     of each button sits 2.2rem from center: a comfortable gap for the
     widest title ("Codex", ~20px half-width) with slack for other
     fonts, and a clean symmetric pair on the page. */
  .paper__codex-footer-inner .paper__codex-lang,
  .paper__codex-footer-inner .paper__close {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  .paper__codex-footer-inner .paper__codex-lang {
    left: 50%;
    margin-left: calc(-2.2rem - 36px);
  }
  .paper__codex-footer-inner .paper__close {
    right: 50%;
    margin-right: calc(-2.2rem - 36px);
  }
  .paper__codex-footer-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.05rem;
    line-height: 1.2;
  }
  .paper__codex-footer .paper__title {
    font-size: 0.92rem;
  }
  /* Subtitle line — mirrors the card's secondary language line */
  .paper__codex-footer-sub {
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--color-text-dim);
  }

  /* Lang toggle — 中文/EN stacked vertically, one click flips.
     Styled as a circular glass button mirroring .paper__close:
     same size, glass background, hairline border, inset highlight,
     and the same hover behaviour. */
  .paper__codex-lang {
    flex: none;
    width: 36px;
    height: 36px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(237, 241, 242, 0.4);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
    border: 1px solid var(--paper-edge);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    overflow: hidden;
    cursor: pointer;
    font: inherit;
    transition: background 0.15s ease;
  }
  .paper__codex-lang-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
    /* Only color transitions. The selected background must switch
       instantly — a background fade would briefly keep the old half
       highlighted, reading as a flicker back to the previous language. */
    transition: color 0.15s ease;
  }
  /* Pull the two labels toward the seam: the top half shifts down,
     the bottom half shifts up, so 中文 and EN read as one unit.
     (padding on the seam side shrinks the content box there, which
     moves the centered label toward the seam.) */
  .paper__codex-lang-item:first-child {
    padding-top: 2px;
  }
  .paper__codex-lang-item:last-child {
    padding-bottom: 2px;
  }
  /* The “switch” seam — horizontal divider between the stacked halves */
  .paper__codex-lang-item:first-child {
    border-bottom: 1px solid var(--paper-hairline);
  }
  /* Selected half: dim the background + deepen the text instead of
     painting a loud accent block — keeps the glass calm and on-paper. */
  .paper__codex-lang-item.is-current {
    color: var(--color-text);
    background: rgba(45, 51, 56, 0.1);
  }
  /* Hover echoes .paper__close: brighten + deepen the idle half */
  .paper__codex-lang:hover {
    background: rgba(237, 241, 242, 0.62);
  }
  .paper__codex-lang:hover .paper__codex-lang-item:not(.is-current) {
    color: var(--color-text);
  }

  /* Bilingual show/hide — driven by the container's data-lang.
     The [data-desc]/[data-rarity]/[data-name]/[data-name-sub]
     spans are plain statically-rendered elements; :global() keeps
     their selectors unscoped. The EN spans ship with a `hidden`
     attribute as the no-JS fallback (default zh); when EN is active
     we explicitly override it. */
  #codex-view[data-lang='zh'] :global([data-desc='en']),
  #codex-view[data-lang='zh'] :global([data-rarity='en']),
  #codex-view[data-lang='zh'] :global([data-name='en']),
  #codex-view[data-lang='zh'] :global([data-name-sub='en']) {
    display: none;
  }
  #codex-view[data-lang='en'] :global([data-desc='zh']),
  #codex-view[data-lang='en'] :global([data-rarity='zh']),
  #codex-view[data-lang='en'] :global([data-name='zh']),
  #codex-view[data-lang='en'] :global([data-name-sub='zh']) {
    display: none;
  }
  #codex-view[data-lang='en'] :global([data-desc='en']),
  #codex-view[data-lang='en'] :global([data-rarity='en']),
  #codex-view[data-lang='en'] :global([data-name='en']),
  #codex-view[data-lang='en'] :global([data-name-sub='en']) {
    display: inline;
  }
  .paper__codex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 0.9rem;
  }
  .paper__codex-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--paper-edge);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.42);
    -webkit-backdrop-filter: blur(8px) saturate(108%);
    backdrop-filter: blur(8px) saturate(108%);
    box-shadow: 0 1px 2px rgba(45, 51, 56, 0.04);
    overflow: hidden;
    animation: paper-card-in 0.22s var(--paper-ease);
  }
  .paper__codex-card-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 104px;
    padding: 0.9rem 1rem;
    background: linear-gradient(180deg, #e9ebed 0%, #dfe4e6 60%, #d2d9db 100%);
  }
  /* The SVG is injected via set:html, so it has no scope attr */
  .paper__codex-card-media :global(svg) {
    display: block;
    max-width: 100%;
    max-height: 100%;
  }
  .paper__codex-badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .paper__codex-badge--common {
    background: rgba(45, 51, 56, 0.08);
    color: var(--color-text-dim);
  }
  .paper__codex-badge--rare {
    background: rgba(148, 35, 31, 0.12);
    color: var(--color-accent);
  }
  .paper__codex-card-body {
    padding: 0.7rem 0.85rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }
  .paper__codex-card-name {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-text);
    margin: 0;
  }
  .paper__codex-card-en {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }
  .paper__codex-card-desc {
    margin: 0.3rem 0 0;
    font-size: 0.74rem;
    line-height: 1.65;
    color: var(--paper-ink);
  }

  /* Compact footer on small screens.
     Keep the lang toggle 36px — same as .paper__close (which never
     shrinks), so the symmetric pair stays equal. */
  @media (max-width: 640px) {
    .paper__codex-footer {
      padding: 0.55rem 0.75rem calc(0.55rem + env(safe-area-inset-bottom));
    }
    .paper__codex-footer-inner {
      gap: 0.7rem;
    }
    .paper__codex-lang-item {
      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper__codex-card {
      animation: none;
    }
  }
</style>

<script>
  /* Codex description language — view-local (same pattern as MusicView).
     Pure CSS show/hide via container data-lang; persisted in localStorage. */
  const KEY = 'codex.lang';
  const view = document.getElementById('codex-view');

  function applyLang(lang: 'zh' | 'en') {
    if (!view) return;
    view.dataset.lang = lang;
    document.querySelectorAll<HTMLElement>('.paper__codex-lang-item').forEach((item) => {
      item.classList.toggle('is-current', item.dataset.langItem === lang);
    });
  }

  /* One button, one action: click flips the language. */
  document.querySelector<HTMLElement>('.paper__codex-lang')?.addEventListener('click', () => {
    const current: 'zh' | 'en' = view?.dataset.lang === 'en' ? 'en' : 'zh';
    const next: 'zh' | 'en' = current === 'zh' ? 'en' : 'zh';
    applyLang(next);
    /* Persist after the current frame has committed — UI updates first,
       storage I/O can never delay or double-trigger a paint. localStorage
       is synchronous, but deferring it keeps rendering and persistence
       in separate tasks so a slow/blocked store can't cause a visible
       state flip-flop. */
    requestAnimationFrame(() => {
      try {
        localStorage.setItem(KEY, next);
      } catch {
        /* storage unavailable — non-fatal */
      }
    });
  });

  /* Initial language:
     - explicit user choice (localStorage) wins
     - otherwise, probe the system language (zh → zh, anything else → en)
     - last resort: zh */
  function systemLang(): 'zh' | 'en' {
    const langs = navigator.languages?.length ? navigator.languages : [navigator.language];
    return langs.some((l) => l.toLowerCase().startsWith('zh')) ? 'zh' : 'en';
  }

  let initial: 'zh' | 'en' = 'zh';
  try {
    const saved = localStorage.getItem(KEY);
    if (saved === 'en' || saved === 'zh') {
      initial = saved; // explicit choice — respect it
    } else {
      initial = systemLang(); // never chosen — follow the system
    }
  } catch {
    /* storage unavailable — fall back to system probe */
    initial = systemLang();
  }
  applyLang(initial);
</script>
