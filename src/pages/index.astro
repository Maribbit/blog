---
import Layout from '../layouts/Layout.astro';
import Character from '../components/Character.astro';
import Bookshelf from '../components/Bookshelf.astro';
import WallClock from '../components/WallClock.astro';
import Overlays from '../components/Overlays.astro';
---

<Layout title="Maribbit's Blog 2.5D | 海兔的 2.5D 博客">
  <main class="room">
    <div class="wall"></div>
    <div class="floor"></div>

    <!-- Wall clock, synced to the current time -->
    <div class="obj obj--clock">
      <WallClock />
    </div>

    <!-- Bookshelf behind the character, offset for depth -->
    <div class="obj obj--shelf">
      <div class="contact-shadow contact-shadow--shelf"></div>
      <Bookshelf />
    </div>

    <!-- Character, front and center. Clicking her opens the About view. -->
    <div
      class="obj obj--character"
      data-nav="about"
      role="button"
      tabindex="0"
      aria-label="关于海兔"
    >
      <div class="contact-shadow contact-shadow--character"></div>
      <Character />
    </div>

    <Overlays />
  </main>
</Layout>

<style>
  .room {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }

  .wall {
    position: absolute;
    inset: 0 0 26% 0;
    background: var(--color-bg);
  }

  .floor {
    position: absolute;
    inset: 74% 0 0 0;
    background: var(--color-floor);
    box-shadow: inset 0 1px 0 var(--color-line);
  }

  .obj {
    position: absolute;
  }

  /* Character: centered, standing on the floor line.
     Aspect ratio matches the new SVG viewBox (453 x 1380). */
  .obj--character {
    left: 50%;
    bottom: 2vh;
    height: 82vh;
    aspect-ratio: 453 / 1380;
    transform: translateX(-50%);
    z-index: 20;
    cursor: pointer;
  }

  /* Bookshelf: back-left, smaller for depth */
  .obj--shelf {
    left: 12%;
    bottom: 24vh;
    height: 42vh;
    aspect-ratio: 260 / 360;
    z-index: 10;
  }

  /* Clock: upper-right on the wall */
  .obj--clock {
    right: 12%;
    top: 12vh;
    width: clamp(90px, 12vh, 150px);
    aspect-ratio: 1 / 1;
    z-index: 10;
  }

  /* Grounding shadows */
  .contact-shadow {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      var(--color-shadow) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .contact-shadow--character {
    bottom: 1vh;
    width: 46%;
    height: 5vh;
  }

  .contact-shadow--shelf {
    bottom: -2vh;
    width: 84%;
    height: 4vh;
  }

  @media (max-width: 720px) {
    .obj--character {
      height: 66vh;
    }
    .obj--shelf {
      left: 4%;
      height: 34vh;
      bottom: 20vh;
    }
    .obj--clock {
      right: 6%;
    }
  }
</style>
