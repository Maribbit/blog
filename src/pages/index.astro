---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Maribbit's Blog 3D | 海兔的 3D 博客">
  <!-- Full-viewport 3D stage. Everything else is an overlay. -->
  <div class="stage">
    <canvas id="model-canvas"></canvas>

    <!-- HUD: minimal, top-left "stat sheet" feel -->
    <div class="hud hud--top-left">
      <div class="hud__label">CHARACTER</div>
      <div class="hud__title">海兔 / Maribbit</div>
      <div class="hud__meta">
        <span>AGE 26</span>
        <span>·</span>
        <span>172cm</span>
      </div>
    </div>

    <!-- HUD: bottom hint -->
    <div class="hud hud--bottom">
      <span class="hud__dot"></span>
      <span>拖拽旋转 · 滚轮缩放 · 右键平移</span>
    </div>

    <!-- Loading hint, removed by the viewer once initialized -->
    <div class="loading-hint" id="loading-hint">模型加载中…</div>
  </div>
</Layout>

<script>
  import { initModelViewer } from '../scripts/model-viewer.js';

  const canvas = document.getElementById('model-canvas');
  const loadingHint = document.getElementById('loading-hint');

  function startViewer() {
    if (!canvas) return;
    initModelViewer('model-canvas', '/models/Body.glb');
    if (loadingHint) {
      loadingHint.style.opacity = '0';
      setTimeout(() => loadingHint?.remove(), 500);
    }
  }

  // Ensure the canvas has a non-zero size before initializing
  if (canvas && canvas.clientWidth > 0) {
    startViewer();
  } else {
    requestAnimationFrame(startViewer);
  }
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: var(--color-bg-deep);
  }

  #model-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud {
    position: absolute;
    color: var(--color-text);
    pointer-events: none;
    user-select: none;
    font-feature-settings: 'tnum' 1, 'ss01' 1;
  }

  .hud--top-left {
    top: 1.6rem;
    left: 1.8rem;
    border-left: 1px solid var(--color-line);
    padding-left: 0.9rem;
  }

  .hud__label {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--color-text-dim);
    text-transform: uppercase;
  }

  .hud__title {
    margin-top: 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hud__meta {
    margin-top: 0.2rem;
    display: flex;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .hud--bottom {
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .hud__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .loading-hint {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-text-dim);
    font-size: 0.95rem;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
</style>
