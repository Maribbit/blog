---
// Three navigable surfaces on the shared Maribbit Paper system:
//   #about   -> paper card  (clicking the character)
//   #reading -> paper page  (clicking the notebook)
//   #music   -> paper card  (clicking the headphone)
//
// Layout philosophy: content-centric, not chrome-centric.
// Dismiss / back hang off the content box itself (left/right docks),
// so mouse travel stays in the content neighborhood — never forced
// to viewport corners. No full-bleed top bars.
//
// Any [data-nav="x"] opens #x; [data-close] / Esc / browser Back close.
import { Content, frontmatter } from '../articles/finding-breath.md';
---

<!-- ABOUT: note in the room; close hangs off the card's right edge. -->
<div class="paper paper--card" id="about-view" data-open="false" aria-hidden="true">
  <div class="paper__scrim" data-close></div>

  <div class="paper__stage paper__stage--card">
    <section
      class="paper__sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="about-title"
    >
      <header class="paper__intro">
        <span class="paper__label">About</span>
        <h2 class="paper__title" id="about-title">关于</h2>
      </header>

      <div class="paper__body">
        <p>你好，我是海兔。这是一个关于图形、克制与实验的 2.5D 博客。</p>
        <p>
          比起把内容塞进一张卡片，我更想把它做成一个可以走进去的房间。点亮的时钟、
          身后的书架，都是可以点开的入口。
        </p>
        <p class="paper__quiet">书架里放着可长读的文字 · 时钟走着真实的时间</p>
      </div>

      <!-- Docked to the sheet, not the viewport -->
      <button
        class="paper__dock paper__dock--close"
        type="button"
        data-close
        aria-label="关闭"
      >
        <span class="paper__x" aria-hidden="true"></span>
      </button>
    </section>
  </div>
</div>

<!-- READING: floating column; back hangs left, label hangs right. -->
<div class="paper paper--page" id="reading-view" data-open="false" aria-hidden="true">
  <div class="paper__veil" aria-hidden="true"></div>

  <div class="paper__scroll" id="reading-scroll" tabindex="-1">
    <div class="paper__stage paper__stage--page">
      <div class="paper__col">
        <button
          class="paper__dock paper__dock--back"
          type="button"
          data-close
          aria-label="返回"
        >
          <span class="paper__arrow" aria-hidden="true"></span>
          <span class="paper__dock-label">返回</span>
        </button>

        <span class="paper__dock paper__dock--mark" aria-hidden="true">Reading</span>

        <nav class="paper__index" aria-label="文章索引">
          <span class="paper__label">近期</span>
          <ol>
            <li>
              <a href="#reading">在低面数里寻找呼吸感</a>
              <time>2026 · 07</time>
            </li>
            <li>
              <a href="#reading">当 AI 成为我的绘图搭档</a>
              <time>2026 · 06</time>
            </li>
            <li>
              <a href="#reading">克制，是一种设计的勇气</a>
              <time>2026 · 05</time>
            </li>
          </ol>
        </nav>

        <article class="paper-prose">
          <p class="paper-prose__kicker">{frontmatter.kicker}</p>
          <h1>{frontmatter.title}</h1>
          <p class="paper-prose__meta">
            {frontmatter.date} · {frontmatter.readingTime}
          </p>

          <div class="paper-prose__body">
            <Content />
          </div>

          <div class="paper-prose__end" aria-hidden="true"></div>
        </article>
      </div>
    </div>
  </div>
</div>

<!-- MUSIC: full-width overlay with track navigation. -->
<div class="paper paper--music" id="music-view" data-open="false" aria-hidden="true">
  <div class="paper__veil paper__veil--music" aria-hidden="true"></div>

  <div class="paper__scroll" id="music-scroll" tabindex="-1">
    <div class="paper__music-container">
      <div class="paper__music-header">
        <span class="paper__label">Now Playing</span>
        <button class="paper__music-close" type="button" data-close aria-label="关闭">
          <span class="paper__x" aria-hidden="true"></span>
        </button>
      </div>

      <!-- Track list on top: read it first, then play below -->
      <div class="paper__music-tracklist">
        <button class="paper__music-track" data-track="0" type="button">
          <span class="paper__music-num">01</span>
          <span class="paper__music-info"><span class="paper__music-title">白猫海贼船</span><span class="paper__music-artist">Yunomi feat. 日南结里</span></span>
          <span class="paper__music-indicator" aria-hidden="true"></span>
        </button>
        <button class="paper__music-track" data-track="1" type="button">
          <span class="paper__music-num">02</span>
          <span class="paper__music-info"><span class="paper__music-title">一天到晚游泳的鱼</span><span class="paper__music-artist">张雨生 Tom Chang</span></span>
          <span class="paper__music-indicator" aria-hidden="true"></span>
        </button>
        <button class="paper__music-track" data-track="2" type="button">
          <span class="paper__music-num">03</span>
          <span class="paper__music-info"><span class="paper__music-title">离家出走</span><span class="paper__music-artist">卫兰 Janice Vidal</span></span>
          <span class="paper__music-indicator" aria-hidden="true"></span>
        </button>
      </div>

      <!-- Embed below -->
      <div class="paper__music-embed">
        <iframe
          id="music-iframe"
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          frameborder="0"
          height="150"
          style="width:100%;max-width:500px;overflow:hidden;border-radius:10px;background:transparent;"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          src="https://embed.music.apple.com/us/album/%E7%A6%BB%E5%AE%B6%E5%87%BA%E8%B5%B0/557096396?i=557096400"
          loading="lazy"
          title="Apple Music 播放器"
        ></iframe>
      </div>

      <!-- Nav controls grouped below the embed -->
      <div class="paper__music-controls">
        <div class="paper__music-nav paper__music-nav--prev" id="music-prev" role="button" tabindex="0" aria-label="上一首">
          <span class="paper__music-arrow paper__music-arrow--left" aria-hidden="true"></span>
        </div>
        <div class="paper__music-nav paper__music-nav--next" id="music-next" role="button" tabindex="0" aria-label="下一首">
          <span class="paper__music-arrow paper__music-arrow--right" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ═══════════════════════════════════════════════════════════════
     Maribbit Paper — content-centric surfaces
     Controls are absolute docks on the content box edges.
     ═══════════════════════════════════════════════════════════════ */

  .paper {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }
  .paper[data-open='true'] {
    display: flex;
  }

  /* ---------- Shared type ---------- */
  .paper__label {
    display: block;
    font-size: var(--paper-label);
    letter-spacing: var(--paper-label-track);
    text-transform: uppercase;
    color: var(--color-text-dim);
    line-height: 1.2;
  }
  .paper__title {
    font-size: var(--paper-title-card);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }

  /* ---------- Dock controls (hang off content) ---------- */
  .paper__dock {
    position: absolute;
    z-index: 3;
    border: none;
    background: rgba(237, 241, 242, 0.4);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
    border: 1px solid var(--paper-edge);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: var(--color-text-dim);
    font: inherit;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .paper__dock:hover {
    color: var(--color-accent);
    background: rgba(237, 241, 242, 0.62);
  }
  .paper__dock--close {
    top: 0.7rem;
    /* Sit just outside the right edge of the sheet */
    right: 0;
    transform: translateX(calc(100% + 0.55rem));
    width: 36px;
    height: 36px;
    border-radius: 999px;
    padding: 0;
  }
  .paper__dock--back {
    top: 0.15rem;
    left: 0;
    transform: translateX(calc(-100% - 0.7rem));
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 0.7rem 0.48rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--color-text);
    white-space: nowrap;
  }
  .paper__dock--mark {
    top: 0.55rem;
    right: 0;
    background: none;
    border: none;
    box-shadow: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    cursor: default;
    pointer-events: none;
    padding: 0;
    font-size: var(--paper-label);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: translateX(calc(100% + 0.85rem)) rotate(180deg);
    color: var(--color-text-dim);
    opacity: 0.8;
    user-select: none;
  }
  .paper__x {
    position: absolute;
    inset: 0;
  }
  .paper__x::before,
  .paper__x::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
  }
  .paper__x::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .paper__x::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .paper__arrow {
    position: relative;
    width: 10px;
    height: 10px;
    flex: none;
  }
  .paper__arrow::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-left: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-50%) rotate(45deg);
  }

  /* ──────────── Card ──────────── */
  .paper--card {
    align-items: center;
    justify-content: center;
    /* Extra side room so the hanging close button is never clipped */
    padding: 1.25rem 3.25rem;
  }
  .paper__scrim {
    position: absolute;
    inset: 0;
    background: var(--paper-scrim);
    animation: paper-scrim-in 0.2s var(--paper-ease);
  }
  .paper__stage--card {
    position: relative;
    width: min(400px, 100%);
    animation: paper-card-in 0.22s var(--paper-ease);
  }
  .paper--card .paper__sheet {
    position: relative;
    width: 100%;
    background: var(--paper-bg);
    -webkit-backdrop-filter: blur(var(--paper-blur)) saturate(var(--paper-saturate));
    backdrop-filter: blur(var(--paper-blur)) saturate(var(--paper-saturate));
    border: 1px solid var(--paper-edge);
    box-shadow: var(--paper-shadow);
    color: var(--color-text);
    /* Allow docks to paint outside the sheet */
    overflow: visible;
  }
  .paper__intro {
    padding: var(--paper-pad-y-card) var(--paper-pad-x-card) 0;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }
  .paper__intro .paper__title::after {
    content: '';
    display: block;
    width: 1.5rem;
    height: 2px;
    margin-top: 0.6rem;
    background: var(--color-accent);
  }
  .paper__body {
    padding: 1rem var(--paper-pad-x-card) calc(var(--paper-pad-y-card) + 0.1rem);
    font-size: var(--paper-body);
    line-height: var(--paper-body-lh);
    color: var(--paper-ink);
  }
  .paper__body p {
    margin: 0 0 0.9em;
  }
  .paper__body p:last-child {
    margin-bottom: 0;
  }
  .paper__quiet {
    margin-top: 1.1em !important;
    padding-top: 1em;
    border-top: 1px solid var(--paper-hairline);
    color: var(--color-text-dim);
    font-size: var(--paper-quiet);
    letter-spacing: 0.02em;
    line-height: 1.55;
  }

  /* ──────────── Page ──────────── */
  .paper--page {
    display: none;
  }
  .paper--page[data-open='true'] {
    display: block;
  }
  /* Soft veil: denser on the reading axis, open at the edges so the sea shows */
  .paper__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 62% 74% at 50% 42%,
        var(--paper-bg-dense) 0%,
        rgba(237, 241, 242, 0.34) 55%,
        rgba(237, 241, 242, 0.1) 100%
      );
    -webkit-backdrop-filter: blur(var(--paper-blur)) saturate(var(--paper-saturate));
    backdrop-filter: blur(var(--paper-blur)) saturate(var(--paper-saturate));
    animation: paper-page-in 0.28s var(--paper-ease);
  }
  .paper__scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    outline: none;
  }
  .paper__stage--page {
    /* Reserve side gutters so hanging docks aren't clipped by the scrollport */
    --dock-gutter: clamp(4.5rem, 12vw, 7.5rem);
    width: min(
      calc(var(--paper-col) + 2 * var(--dock-gutter)),
      100%
    );
    margin: 0 auto;
    padding: var(--paper-pad-y-page) var(--dock-gutter) 5.5rem;
  }
  .paper__col {
    position: relative;
    width: min(var(--paper-col), 100%);
    margin: 0 auto;
    background: linear-gradient(
      to bottom,
      rgba(237, 241, 242, 0.36) 0%,
      rgba(237, 241, 242, 0.2) 100%
    );
    border: 1px solid var(--paper-hairline);
    box-shadow: var(--paper-shadow);
    padding: clamp(1.5rem, 4vh, 2.25rem) var(--paper-pad-x-page)
      clamp(2rem, 5vh, 2.75rem);
    -webkit-backdrop-filter: blur(8px) saturate(108%);
    backdrop-filter: blur(8px) saturate(108%);
    overflow: visible;
  }

  /* Index */
  .paper__index {
    margin-bottom: clamp(1.75rem, 4vh, 2.5rem);
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--paper-hairline);
  }
  .paper__index .paper__label {
    margin-bottom: 0.75rem;
  }
  .paper__index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .paper__index li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.38rem 0;
  }
  .paper__index a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .paper__index a:hover {
    color: var(--color-accent);
    border-bottom-color: rgba(148, 35, 31, 0.35);
  }
  .paper__index time {
    flex: none;
    font-size: var(--paper-quiet);
    color: var(--color-text-dim);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* Long-form */
  .paper-prose {
    color: var(--color-text);
  }
  .paper-prose__kicker {
    font-size: var(--paper-label);
    letter-spacing: var(--paper-label-track);
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.85rem;
  }
  .paper-prose h1 {
    font-size: var(--paper-title-page);
    line-height: 1.22;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin: 0 0 0.65rem;
  }
  .paper-prose__meta {
    color: var(--color-text-dim);
    font-size: var(--paper-quiet);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    margin: 0 0 1.85rem;
  }
  .paper-prose__body :global(h2) {
    font-size: 1.12rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 2.2rem 0 0.65rem;
    color: var(--color-text);
  }
  .paper-prose__body :global(p) {
    font-size: var(--paper-body);
    line-height: var(--paper-body-lh);
    margin: 0 0 1.1em;
    color: var(--paper-ink);
  }
  .paper-prose__body :global(blockquote) {
    margin: 1.7rem 0;
    padding: 0.15rem 0 0.15rem 1.1rem;
    border-left: 2px solid var(--color-accent);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .paper-prose__body :global(blockquote p) {
    margin: 0;
    color: inherit;
  }
  .paper-prose__end {
    width: 2rem;
    height: 1px;
    margin: 2.75rem auto 0;
    background: var(--paper-hairline);
  }

  /*
    Compact widths: keep docks near content, but don't force them into
    viewport corners. Slide them onto the top edge of the content box
    instead of the left/right exterior when gutters get too tight.
  */
  @media (max-width: 640px) {
    .paper--card {
      padding: 1rem 1rem 1.25rem;
    }
    .paper__dock--close {
      top: 0.55rem;
      right: 0.55rem;
      transform: none;
    }
    .paper__stage--page {
      --dock-gutter: 1rem;
      padding-top: calc(var(--paper-pad-y-page) + 0.25rem);
    }
    .paper__dock--back {
      top: 0;
      left: 0;
      transform: translateY(calc(-100% - 0.55rem));
    }
    .paper__dock--mark {
      display: none;
    }
  }

  /* ──────────── Music overlay (full-width) ──────────── */
  .paper--music {
    display: none;
  }
  .paper--music[data-open='true'] {
    display: flex;
    flex-direction: column;
  }
  .paper__veil--music {
    position: absolute;
    inset: 0;
    pointer-events: auto;
    background:
      radial-gradient(
        ellipse 70% 60% at 50% 45%,
        rgba(237, 241, 242, 0.72) 0%,
        rgba(237, 241, 242, 0.38) 55%,
        rgba(237, 241, 242, 0.1) 100%
      );
    -webkit-backdrop-filter: blur(14px) saturate(108%);
    backdrop-filter: blur(14px) saturate(108%);
    animation: paper-page-in 0.28s var(--paper-ease);
  }
  .paper--music .paper__scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    outline: none;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .paper__music-container {
    position: relative;
    width: min(520px, 92%);
    padding: 2rem 0 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  /* Header */
  .paper__music-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .paper__music-header .paper__label {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--color-text-dim);
  }
  .paper__music-close {
    position: relative;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 999px;
    background: rgba(237, 241, 242, 0.4);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
    border: 1px solid var(--paper-edge);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: var(--color-text-dim);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
    flex: none;
  }
  .paper__music-close:hover {
    color: var(--color-accent);
    background: rgba(237, 241, 242, 0.62);
  }

  /* Embed row — just the player, centered */
  .paper__music-embed {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .paper__music-embed iframe {
    flex: none;
    border-radius: 10px;
  }

  /* Nav controls grouped below the embed */
  .paper__music-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .paper__music-nav {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(237, 241, 242, 0.4);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
    border: 1px solid var(--paper-edge);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
    color: var(--color-text-dim);
    user-select: none;
  }
  .paper__music-nav:hover {
    color: var(--color-accent);
    background: rgba(237, 241, 242, 0.62);
  }
  .paper__music-nav.is-disabled {
    opacity: 0.25;
    cursor: default;
    pointer-events: none;
  }
  .paper__music-arrow {
    display: block;
    width: 10px;
    height: 10px;
    position: relative;
  }
  .paper__music-arrow::before {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-left: 1.8px solid currentColor;
    border-bottom: 1.8px solid currentColor;
  }
  .paper__music-arrow--left::before {
    left: 4px;
    transform: translateY(-50%) rotate(45deg);
  }
  .paper__music-arrow--right::before {
    right: 4px;
    transform: translateY(-50%) rotate(-135deg);
  }

  /* Track list */
  .paper__music-tracklist {
    width: 100%;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .paper__music-track {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.75rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--color-text);
    transition: background 0.15s ease;
    position: relative;
  }
  .paper__music-track:hover {
    background: rgba(237, 241, 242, 0.35);
  }
  .paper__music-track.is-active {
    background: rgba(237, 241, 242, 0.22);
  }
  .paper__music-track.is-active .paper__music-indicator {
    opacity: 1;
  }
  .paper__music-num {
    font-size: 0.72rem;
    color: var(--color-text-dim);
    width: 1.5rem;
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .paper__music-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }
  .paper__music-title {
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .paper__music-artist {
    font-size: 0.72rem;
    color: var(--color-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .paper__music-indicator {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-accent, #94231f);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  /* Motion */
  @keyframes paper-scrim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes paper-card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes paper-page-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper__scrim,
    .paper__stage--card,
    .paper__veil {
      animation: none;
    }
  }
</style>

<script>
  const VIEWS = ['about', 'reading', 'music'] as const;
  type View = (typeof VIEWS)[number];

  const surfaces: Record<View, HTMLElement | null> = {
    about: document.getElementById('about-view'),
    reading: document.getElementById('reading-view'),
    music: document.getElementById('music-view'),
  };
  const readingScroll = document.getElementById('reading-scroll');
  const musicScroll = document.getElementById('music-scroll');

  /* ─── Apple Music tracks (US store: longer previews) ─── */
  const TRACKS = [
    { label: 'Yunomi — 白猫海贼船', src: 'https://embed.music.apple.com/us/album/%E7%99%BD%E7%8C%AB%E6%B5%B7%E8%B3%8A%E8%88%B9-feat-%E6%97%A5%E5%8D%97%E7%B5%90%E9%87%8C/1449115362?i=1449115365' },
    { label: '张雨生 — 一天到晚游泳的鱼', src: 'https://embed.music.apple.com/us/album/%E4%B8%80%E5%A4%A9%E5%88%B0%E6%99%9A%E6%B8%B8%E6%B3%B3%E7%9A%84%E9%B1%BC/298780288?i=298780327' },
    { label: '卫兰 — 离家出走', src: 'https://embed.music.apple.com/us/album/%E7%A6%BB%E5%AE%B6%E5%87%BA%E8%B5%B0/557096396?i=557096400' },
  ];

  let currentTrack = 0;
  let musicInited = false;  // true once iframe src has been set

  function renderTrack(trackEls: NodeListOf<Element>, iframe: HTMLIFrameElement, prevBtn: HTMLElement, nextBtn: HTMLElement, setSrc: boolean) {
    trackEls.forEach((el, i) => {
      el.classList.toggle('is-active', i === currentTrack);
    });
    if (setSrc) {
      iframe.src = TRACKS[currentTrack].src;
    }
    prevBtn.classList.toggle('is-disabled', currentTrack === 0);
    nextBtn.classList.toggle('is-disabled', currentTrack >= TRACKS.length - 1);
  }

  function currentView(): View | null {
    const key = location.hash.replace(/^#/, '');
    return (VIEWS as readonly string[]).includes(key) ? (key as View) : null;
  }

  function render() {
    const active = currentView();
    for (const view of VIEWS) {
      const el = surfaces[view];
      if (!el) continue;
      const open = view === active;
      el.dataset.open = String(open);
      el.setAttribute('aria-hidden', String(!open));
    }
    if (active === 'reading' && readingScroll) {
      readingScroll.scrollTop = 0;
      readingScroll.focus({ preventScroll: true });
    }
    if (active === 'music') {
      initMusicView();
    }
  }

  function initMusicView() {
    const iframe = document.getElementById('music-iframe') as HTMLIFrameElement | null;
    const prevBtn = document.getElementById('music-prev');
    const nextBtn = document.getElementById('music-next');
    const tracks = document.querySelectorAll('.paper__music-track');
    if (!iframe || !prevBtn || !nextBtn) return;
    // Only set iframe src once (on first open); reassigning reloads the player
    renderTrack(tracks, iframe, prevBtn, nextBtn, !musicInited);
    musicInited = true;
  }

  function switchTrack(delta: number) {
    const iframe = document.getElementById('music-iframe') as HTMLIFrameElement | null;
    const prevBtn = document.getElementById('music-prev');
    const nextBtn = document.getElementById('music-next');
    const tracks = document.querySelectorAll('.paper__music-track');
    if (!iframe || !prevBtn || !nextBtn) return;
    const next = currentTrack + delta;
    if (next < 0 || next >= TRACKS.length) return;
    currentTrack = next;
    renderTrack(tracks, iframe, prevBtn, nextBtn, true);
  }

  function openView(view: string) {
    if (location.hash === `#${view}`) return;
    location.hash = `#${view}`;
  }

  function closeView() {
    if (!location.hash) return;
    history.replaceState(null, '', location.pathname + location.search);
    render();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('[data-nav]');
    if (trigger) {
      e.preventDefault();
      openView(trigger.getAttribute('data-nav') as string);
      return;
    }
    if (target.closest('[data-close]')) {
      e.preventDefault();
      closeView();
      return;
    }
    /* Music: prev / next */
    const prevBtn = target.closest('#music-prev');
    if (prevBtn) { e.preventDefault(); switchTrack(-1); return; }
    const nextBtn = target.closest('#music-next');
    if (nextBtn) { e.preventDefault(); switchTrack(1); return; }
    /* Music: track selection */
    const trackBtn = target.closest('.paper__music-track');
    if (trackBtn) {
      e.preventDefault();
      const idx = parseInt(trackBtn.getAttribute('data-track') || '0', 10);
      if (!isNaN(idx) && idx >= 0 && idx < TRACKS.length) {
        currentTrack = idx;
        const iframe = document.getElementById('music-iframe') as HTMLIFrameElement | null;
        const prevBtn2 = document.getElementById('music-prev');
        const nextBtn2 = document.getElementById('music-next');
        const tracks = document.querySelectorAll('.paper__music-track');
        if (iframe && prevBtn2 && nextBtn2) renderTrack(tracks, iframe, prevBtn2, nextBtn2, true);
      }
      return;
    }
  });

  /* Music nav keydown support */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentView()) {
      closeView();
      return;
    }
    if (e.key === 'Enter' || e.key === ' ') {
      const el = document.activeElement as HTMLElement | null;
      const view = el?.closest('[data-nav]')?.getAttribute('data-nav');
      if (view) {
        e.preventDefault();
        openView(view);
      }
    }
  });

  window.addEventListener('hashchange', render);
  render();
</script>
