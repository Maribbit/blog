---
// Rigged character: shoulder caps, lapels, and arm groups are now separated
// from the torso so we can drive a layered, anatomically-grounded breath.
//
// 6 independent cycles share a 4.8s base period (5.4s for the skirt) but
// with phase offsets so the figure never looks like a single rubber scale:
//   1. Torso core (Dress + breasts) — chest expansion from the diaphragm.
//   2. Shoulder caps (DropShoulder front/lower L/R) — micro-rotation at the
//      shoulder anchor so the cap rides the rising ribcage.
//   3. Lapels (Lapel front/shadow L/R) — pivot out at the shoulder; chest
//      pushes them apart on inhale, they swing back on exhale.
//   4. Arms (Arm + CoatAndHand + SleeveAndHand L/R) — small pendulum sway
//      from the shoulder joint. Real rotation, not a translate.
//   5. Head + hair — vertical lift only, no scaling. Lags the torso peak.
//   6. Skirt hem pleats — separate, slightly slower micro-cycle.
//   7. (Implicit) Blink + occasional double blink via JS.
//
// All pivots are in the SVG's own 453x1380 viewBox coordinates. The center
// line is x=226.5. preserveAspectRatio is forced to xMidYMax meet so feet
// stay flush with the container bottom at any aspect ratio.
import charSvg from '../assets/character/Character_Standing.svg?raw';

const charSvgPinned = charSvg.replace(
  /<svg([^>]*)>/,
  (match, attrs) =>
    /preserveAspectRatio=/.test(attrs)
      ? match
      : `<svg${attrs} preserveAspectRatio="xMidYMax meet">`
);
---

<div class="character" aria-hidden="true">
  <Fragment set:html={charSvgPinned} />
</div>

<style>
  .character {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .character :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 8px 14px var(--color-shadow));
  }

  /* -------- Pivots, in the SVG's own viewBox coords (453 x 1380) -------- */

  /* Torso core: ribcage expands from the diaphragm (226.5, 730). */
  .character :global(#Dress),
  .character :global(#Breasts_Upper) {
    transform-box: view-box;
    transform-origin: 226.5px 730px;
    animation: breathe-torso-core 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Skirt pleats: independent cycle (5.4s) and phase so the hem breathes
     a beat after the upper torso. Tiny scaleY + a hint of droop. */
  .character :global(#Dress_PleatedHem_Upper) {
    transform-box: view-box;
    transform-origin: 226.5px 562.978px;
    animation: breathe-skirt 5.4s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Shoulder caps: pivot at the shoulder seam, ride the rising ribcage. */
  .character :global(#DropShoulder_Front_R),
  .character :global(#DropShoulder_Lower_R) {
    transform-box: view-box;
    transform-origin: 168.5px 343.978px;
    animation: breathe-shoulder-r 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }
  .character :global(#DropShoulder_Front_L),
  .character :global(#DropShoulder_Lower_L) {
    transform-box: view-box;
    transform-origin: 284.5px 343.978px;
    animation: breathe-shoulder-l 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Lapels: pivot at the shoulder seam, swing outward on inhale. */
  .character :global(#Lapel_Front_R),
  .character :global(#Lapel_Shadow_R) {
    transform-box: view-box;
    transform-origin: 168.5px 343.978px;
    animation: breathe-lapel-r 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }
  .character :global(#Lapel_Front_L),
  .character :global(#Lapel_Shadow_L) {
    transform-box: view-box;
    transform-origin: 284.5px 343.978px;
    animation: breathe-lapel-l 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Arms: real rotation around the shoulder joint. */
  .character :global(#Arm_R),
  .character :global(#CoatAndHand_R),
  .character :global(#SleeveAndHand_R) {
    transform-box: view-box;
    transform-origin: 116px 304.014px;
    animation: breathe-arm-r 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }
  .character :global(#Arm_L),
  .character :global(#CoatAndHand_L),
  .character :global(#SleeveAndHand_L) {
    transform-box: view-box;
    transform-origin: 328.999px 301.477px;
    animation: breathe-arm-l 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Head + hair: NO scaling. Tiny vertical lift, peak lags the torso. */
  .character :global(#Head),
  .character :global(#Hair_Accessory) {
    transform-box: view-box;
    transform-origin: 226.5px 290px;
    animation: breathe-head 4.8s cubic-bezier(0.42, 0, 0.4, 1) infinite;
    will-change: transform;
  }

  /* Blink pivots (used by the JS-side scaleY animation). */
  .character :global(#Eye_R) {
    transform-box: view-box;
    transform-origin: 184px 154px;
  }
  .character :global(#Eye_L) {
    transform-box: view-box;
    transform-origin: 268px 154px;
  }

  /* -------- Keyframes -------- */

  /* Asymmetric breath: 0–34% inhale, 34–46% hold, 46–100% exhale. */
  @keyframes breathe-torso-core {
    0%   { transform: scaleX(1)      scaleY(1)      translateY(0); }
    34%  { transform: scaleX(1.012)  scaleY(1.010)  translateY(-1.6px); }
    46%  { transform: scaleX(1.010)  scaleY(1.008)  translateY(-1.2px); }
    100% { transform: scaleX(1)      scaleY(1)      translateY(0); }
  }

  @keyframes breathe-skirt {
    0%   { transform: scaleX(1)     scaleY(1)     translateY(0); }
    40%  { transform: scaleX(1.004) scaleY(1.006) translateY(0.6px); }
    100% { transform: scaleX(1)     scaleY(1)     translateY(0); }
  }

  /* Right cap tilts up (counter-clockwise) on inhale. */
  @keyframes breathe-shoulder-r {
    0%   { transform: rotate(0deg)    translateY(0); }
    34%  { transform: rotate(-0.9deg) translateY(-1.4px); }
    46%  { transform: rotate(-0.7deg) translateY(-1.1px); }
    100% { transform: rotate(0deg)    translateY(0); }
  }
  @keyframes breathe-shoulder-l {
    0%   { transform: rotate(0deg)   translateY(0); }
    34%  { transform: rotate(0.9deg) translateY(-1.4px); }
    46%  { transform: rotate(0.7deg) translateY(-1.1px); }
    100% { transform: rotate(0deg)   translateY(0); }
  }

  @keyframes breathe-lapel-r {
    0%   { transform: rotate(0deg)    translateY(0); }
    34%  { transform: rotate(-0.6deg) translateY(-1.2px); }
    46%  { transform: rotate(-0.45deg) translateY(-0.9px); }
    100% { transform: rotate(0deg)    translateY(0); }
  }
  @keyframes breathe-lapel-l {
    0%   { transform: rotate(0deg)   translateY(0); }
    34%  { transform: rotate(0.6deg) translateY(-1.2px); }
    46%  { transform: rotate(0.45deg) translateY(-0.9px); }
    100% { transform: rotate(0deg)   translateY(0); }
  }

  @keyframes breathe-arm-r {
    0%   { transform: rotate(0deg)    translateY(0); }
    34%  { transform: rotate(-0.55deg) translateY(-1.2px); }
    46%  { transform: rotate(-0.4deg)  translateY(-0.9px); }
    100% { transform: rotate(0deg)    translateY(0); }
  }
  @keyframes breathe-arm-l {
    0%   { transform: rotate(0deg)   translateY(0); }
    34%  { transform: rotate(0.55deg) translateY(-1.2px); }
    46%  { transform: rotate(0.4deg)  translateY(-0.9px); }
    100% { transform: rotate(0deg)   translateY(0); }
  }

  /* Head peak at 40% (torso peaks at 34%) so it rides the chest, not drives. */
  @keyframes breathe-head {
    0%   { transform: translateY(0); }
    40%  { transform: translateY(-2.6px); }
    52%  { transform: translateY(-2.1px); }
    100% { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .character :global(#Dress),
    .character :global(#Breasts_Upper),
    .character :global(#Dress_PleatedHem_Upper),
    .character :global(#DropShoulder_Front_R),
    .character :global(#DropShoulder_Lower_R),
    .character :global(#DropShoulder_Front_L),
    .character :global(#DropShoulder_Lower_L),
    .character :global(#Lapel_Front_R),
    .character :global(#Lapel_Shadow_R),
    .character :global(#Lapel_Front_L),
    .character :global(#Lapel_Shadow_L),
    .character :global(#Arm_R),
    .character :global(#CoatAndHand_R),
    .character :global(#SleeveAndHand_R),
    .character :global(#Arm_L),
    .character :global(#CoatAndHand_L),
    .character :global(#SleeveAndHand_L),
    .character :global(#Head),
    .character :global(#Hair_Accessory) {
      animation: none;
    }
  }
</style>

<script>
  function setupCharacter() {
    const eyes = [
      document.getElementById('Eye_R'),
      document.getElementById('Eye_L'),
    ].filter((el): el is HTMLElement => el !== null);

    if (!eyes.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // One blink = a quick vertical squash and release of both eyes.
    function blink() {
      for (const eye of eyes) {
        eye.animate(
          [
            { transform: 'scaleY(1)' },
            { transform: 'scaleY(0.06)', offset: 0.5 },
            { transform: 'scaleY(1)' },
          ],
          { duration: 170, easing: 'ease-in-out' }
        );
      }
    }

    // Schedule blinks at irregular intervals; sometimes a quick double blink.
    function scheduleNext() {
      const delay = 2200 + Math.random() * 4200; // 2.2s - 6.4s
      window.setTimeout(() => {
        blink();
        if (Math.random() < 0.28) window.setTimeout(blink, 280);
        scheduleNext();
      }, delay);
    }

    scheduleNext();
  }

  setupCharacter();
</script>
