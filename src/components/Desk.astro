---
// Desk — the surface in front of the character.
//
// Stage-locked block with a trapezoidal step-down in the middle.
// Perspective narrow-fractions are computed via JS at runtime
// (from the sill-derived vanishing point), then set as plain
// CSS custom properties on .desk for the clip-paths to consume.
//
//   viewBox 100 × 100, preserveAspectRatio="none"
//
//   Upper left top:   front x  0→30, back displacements 50→20
//   Left ramp:        top back 20→12, bottom front 0→8 (viewBox y)
//   Lower middle top: front x 38→62, back displacement 12→-12
//   Right ramp:       bottom front 8→0, top back -12→-20
//   Upper right top:  front x 70→100, back displacements -20→-50
//   Front faces:      vertical drops from each top segment's front
//                     edge, straight down to y=100
//
// z-index 25 (above character 20) so the desk occludes the lower body.
---

<div class="desk" aria-hidden="true">
  <svg
    class="desk__svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- ═══════════ TOP FACES ═══════════ -->
    <rect class="desk__face face--upper-left" />
    <rect class="desk__face face--left-ramp" />
    <rect class="desk__face face--lower-mid" />
    <rect class="desk__face face--right-ramp" />
    <rect class="desk__face face--upper-right" />

    <!-- ═══════════ FRONT FACES ═══════════ -->
    <rect class="desk__face face--front-left" />
    <rect class="desk__face face--front-left-ramp" />
    <rect class="desk__face face--front-mid" />
    <rect class="desk__face face--front-right-ramp" />
    <rect class="desk__face face--front-right" />
  </svg>
</div>

<style>
  .desk {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--desk-w);
    height: calc(var(--char-h) * 0.42);
    transform: translateX(-50%);
    z-index: 25;
    overflow: visible;
  }

  .desk__svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .desk__face {
    width: 100%;
    height: 100%;
  }

  /* === TOP FACE COLORS === */
  .face--upper-left,
  .face--lower-mid,
  .face--upper-right {
    fill: #d2d9da;
  }

  .face--left-ramp,
  .face--right-ramp {
    fill: #bfcbcc;
  }

  /* === FRONT FACE COLORS === */
  .face--front-left,
  .face--front-mid,
  .face--front-right,
  .face--front-left-ramp,
  .face--front-right-ramp {
    fill: #a8b5b6;
  }

  /* ═══════════════════════════════════════════════════════════════
     CLIP PATHS — set via JS below as inline styles using the
     resolved --narrow-frac and --narrow-mid-frac (plain numbers).
     ═══════════════════════════════════════════════════════════════ */
</style>

<script>
  import { getStageGeom, narrowFrac } from '../utils/perspective';

  function applyDeskClipPaths(): void {
    const desk = document.querySelector<HTMLElement>('.desk');
    if (!desk) return;

    const g = getStageGeom();

    /* Perspective narrow fractions (plain numbers) */
    const nf  = narrowFrac(g.deskY17 - g.vpY, g.deskTopY - g.vpY);
    const nmf = narrowFrac(g.deskY33 - g.vpY, g.deskY17 - g.vpY);

    const NF = nf, NMF = nmf;

    function clip(pts: [number, number][]): string {
      return 'polygon(' + pts.map(p => p[0] + '% ' + p[1] + '%').join(', ') + ')';
    }

    const q = (sel: string): HTMLElement => desk.querySelector(sel) as HTMLElement;

    q('.face--upper-left').style.clipPath = clip([
      [50 * NF, 0],   [30 + 20 * NF, 0],
      [30, 17],        [0, 17]
    ]);
    q('.face--left-ramp').style.clipPath = clip([
      [30 + 20 * NF, 0],   [38 + 12 * NMF, 17],
      [38, 33],             [30, 17]
    ]);
    q('.face--lower-mid').style.clipPath = clip([
      [38, 33],             [62, 33],
      [62 - 12 * NMF, 17],  [38 + 12 * NMF, 17]
    ]);
    q('.face--right-ramp').style.clipPath = clip([
      [62 - 12 * NMF, 17],  [70 - 20 * NF, 0],
      [70, 17],             [62, 33]
    ]);
    q('.face--upper-right').style.clipPath = clip([
      [70 - 20 * NF, 0],   [100 - 50 * NF, 0],
      [100, 17],            [70, 17]
    ]);

    /* Front faces: vertical drops (no perspective) */
    q('.face--front-left').style.clipPath =
      'polygon(0% 17%, 30% 17%, 30% 100%, 0% 100%)';
    q('.face--front-left-ramp').style.clipPath =
      'polygon(30% 17%, 38% 33%, 38% 100%, 30% 100%)';
    q('.face--front-mid').style.clipPath =
      'polygon(38% 33%, 62% 33%, 62% 100%, 38% 100%)';
    q('.face--front-right-ramp').style.clipPath =
      'polygon(62% 33%, 70% 17%, 70% 100%, 62% 100%)';
    q('.face--front-right').style.clipPath =
      'polygon(70% 17%, 100% 17%, 100% 100%, 70% 100%)';
  }

  requestAnimationFrame(() => { applyDeskClipPaths(); });
  window.addEventListener('resize', applyDeskClipPaths);
</script>
