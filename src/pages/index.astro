---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Maribbit's Blog 2.5D | 海兔的 2.5D 博客">
  <div class="stage">
    <!-- Character card -->
    <div class="card">
      <div class="card__character">
        <img src="/character/Character_T_Pose.svg" alt="Maribbit T-Pose" class="character-svg" />
      </div>
      <div class="card__info">
        <div class="card__label">CHARACTER</div>
        <h1 class="card__title">海兔 / Maribbit</h1>
        <div class="card__meta">
          <span>AGE 26</span>
          <span class="card__sep">·</span>
          <span>172cm</span>
        </div>
      </div>
    </div>

    <!-- Footer hint -->
    <div class="footer-hint">
      <span class="footer-hint__dot"></span>
      <span>2.5D Blog · 海兔</span>
    </div>
  </div>
</Layout>

<style>
  .stage {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: var(--color-bg-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .card__character {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(280px, 45vh, 500px);
    height: clamp(340px, 55vh, 620px);
    background: var(--color-surface);
    border-radius: 1.25rem;
    border: 1px solid var(--color-line);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    padding: 1.25rem;
    transition: box-shadow 0.3s ease;
  }

  .card__character:hover {
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .character-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  .card__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .card__label {
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: var(--color-text-dim);
    text-transform: uppercase;
  }

  .card__title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .card__meta {
    display: flex;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
    font-feature-settings: 'tnum' 1, 'ss01' 1;
  }

  .card__sep {
    color: var(--color-line);
  }

  .footer-hint {
    position: fixed;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
    user-select: none;
  }

  .footer-hint__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }
</style>
