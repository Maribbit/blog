---
// Maribbit Paper — shared overlay shell.
//
// Each surface is its own component (AboutView / MusicView / CodexView);
// this file only owns:
//   1. the shared base styles (is:global — they must match elements
//      rendered inside child components, so they cannot be scoped)
//   2. the hash-routing script (open / close / inert / focus return)
//
// Any [data-nav="x"] opens #x; [data-close] / Esc / browser Back close.
// View-specific behaviour (music track nav, codex grid) lives in the
// respective component.
import AboutView from './AboutView.astro';
import MusicView from './MusicView.astro';
import CodexView from './CodexView.astro';
---

<AboutView />
<MusicView />
<CodexView />

<style is:global>
  /* ═══════════════════════════════════════════════════════════════
     Maribbit Paper — shared base system.
     is:global because these rules must match elements rendered inside
     child view components (which carry their own scope ids).
     Content-centric, not chrome-centric: dismiss / back hang off the
     content box itself, so mouse travel stays in the content
     neighborhood — never forced to viewport corners.
     ═══════════════════════════════════════════════════════════════ */

  .paper {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
  }
  .paper[data-open='true'] {
    display: flex;
  }

  /* ---------- Shared type ---------- */
  .paper__label {
    display: block;
    font-size: var(--paper-label);
    letter-spacing: var(--paper-label-track);
    text-transform: uppercase;
    color: var(--color-text-dim);
    line-height: 1.2;
  }
  .paper__title {
    font-size: var(--paper-title-card);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--color-text);
  }
  .paper__intro {
    padding: var(--paper-pad-y-card) var(--paper-pad-x-card) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.28rem;
  }
  .paper__intro .paper__title {
    /* Replaces the removed accent bar: keeps title→body breathing room */
    margin-bottom: 0.4rem;
  }

  /* ---------- Shared controls ---------- */
  .paper__x {
    position: absolute;
    inset: 0;
  }
  .paper__x::before,
  .paper__x::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
  }
  .paper__x::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .paper__x::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  /* Circular glass close button — shared by music & codex */
  .paper__close {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 999px;
    background: rgba(237, 241, 242, 0.4);
    -webkit-backdrop-filter: blur(10px) saturate(108%);
    backdrop-filter: blur(10px) saturate(108%);
    border: 1px solid var(--paper-edge);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: var(--color-text-dim);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .paper__close:hover {
    color: var(--color-accent);
    background: rgba(237, 241, 242, 0.62);
  }

  /* ---------- Shared scroll layer ---------- */
  /* Full-bleed scroll that centers its sheet via margin:auto —
     auto margins collapse to 0 on overflow, so long sheets scroll
     from the top instead of clipping. */
  .paper__scroll {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    outline: none;
    z-index: 1;
    display: flex;
    justify-content: center;
  }



  /* Motion — no opacity fades; the card slides, the scrim dims */
  @keyframes paper-scrim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes paper-card-in {
    from {
      transform: translateY(10px);
    }
    to {
      transform: none;
    }
  }
</style>

<script>
  const VIEWS = ['about', 'music', 'codex'] as const;
  type View = (typeof VIEWS)[number];

  const surfaces: Record<View, HTMLElement | null> = {
    about: document.getElementById('about-view'),
    music: document.getElementById('music-view'),
    codex: document.getElementById('codex-view'),
  };

  function currentView(): View | null {
    const key = location.hash.replace(/^#/, '');
    return (VIEWS as readonly string[]).includes(key) ? (key as View) : null;
  }

  function render() {
    const active = currentView();
    for (const view of VIEWS) {
      const el = surfaces[view];
      if (!el) continue;
      const open = view === active;
      el.dataset.open = String(open);
      el.setAttribute('aria-hidden', String(!open));
      /* inert makes the closed view un-focusable and un-interactive,
         so focus can never be retained inside a hidden surface. */
      if (open) el.removeAttribute('inert');
      else el.setAttribute('inert', '');
    }
  }

  /* Remember which element opened the current view, so we can return
     focus to it when the view closes. */
  let lastTrigger: HTMLElement | null = null;

  function openView(view: string) {
    if (location.hash === `#${view}`) return;
    location.hash = `#${view}`;
  }

  function closeView() {
    if (!location.hash) return;
    history.replaceState(null, '', location.pathname + location.search);
    render();
    /* Return focus to the element that opened the view. */
    if (lastTrigger) {
      lastTrigger.focus({ preventScroll: true });
      lastTrigger = null;
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('[data-nav]');
    if (trigger) {
      e.preventDefault();
      lastTrigger = trigger as HTMLElement;
      openView(trigger.getAttribute('data-nav') as string);
      return;
    }
    if (target.closest('[data-close]')) {
      e.preventDefault();
      closeView();
      return;
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentView()) {
      closeView();
      return;
    }
    if (e.key === 'Enter' || e.key === ' ') {
      const el = document.activeElement as HTMLElement | null;
      const view = el?.closest('[data-nav]')?.getAttribute('data-nav');
      if (view) {
        e.preventDefault();
        lastTrigger = el;
        openView(view);
      }
    }
  });

  window.addEventListener('hashchange', render);
  render();
</script>
