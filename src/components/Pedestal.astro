---
// Pedestal — simplified to just the top face for perspective debugging.
---

<div class="pedestal" id="pedestal" aria-hidden="true">
  <svg
    class="pedestal__svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    overflow="visible"
    xmlns="http://www.w3.org/2000/svg"
  ></svg>
</div>

<style>
  .pedestal {
    position: absolute;
    left: 43%;
    top: 21%;
    width: calc(20 * var(--cm));
    height: calc(20 * var(--cm) * 689 / 418);
    transform: translateX(-85%);
    z-index: 25;
    pointer-events: none;
  }

  .pedestal__svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { getStageGeom } from '../utils/perspective';
  import { projectBox, projectWireframe, calcScaleBack, calcVpXLocal, calcVpYLocal } from '../utils/cube';

  function buildPedestal() {
    const pedEl = document.getElementById('pedestal');
    if (!pedEl) return;
    const svg = pedEl.querySelector('.pedestal__svg') as unknown as SVGSVGElement;
    if (!svg) return;

    /* ─── Read room geometry ─── */
    const g = getStageGeom();
    const desk = document.querySelector<HTMLElement>('.desk');
    if (!desk) return;

    const pedRect = pedEl.getBoundingClientRect();
    const deskRect = desk.getBoundingClientRect();
    const deskCenterX = deskRect.left + deskRect.width / 2;

    /* ─── Build projection context ─── */
    const CUBE = { cx: 46, hw: 35, topY: 32, botY: 45 };
    const BACK_VB_Y = 2;
    const ctx = {
      vpX: calcVpXLocal(pedRect, deskCenterX),
      vpY: calcVpYLocal(pedRect, g.vpY),
      scaleBack: calcScaleBack(g.vpY, pedRect.top, pedRect.height, CUBE.topY, BACK_VB_Y),
    };

    /* ─── Project ─── */
    const faces = projectBox(CUBE, ctx);
    const wf    = projectWireframe(CUBE, ctx);

    console.log('=== CUBE WIREFRAME ===');
    console.log('VP:', ctx.vpX.toFixed(1), ctx.vpY.toFixed(1));
    console.log('scaleBack:', ctx.scaleBack.toFixed(4));
    console.log('Top:',   faces.top);
    console.log('Front:', faces.front);
    console.log('Right:', faces.right);

    /* ─── Render ─── */
    const svgNS = 'http://www.w3.org/2000/svg';
    const colors = { top: '#d2d9da', front: '#a8b5b6', right: '#96a2a3', stroke: '#4a5259' };

    /* Solid faces (back-to-front: right → front → top) */
    const faceSpec: { id: string; fill: string; d: string }[] = [
      { id: 'pf-right', fill: colors.right, d: faces.right },
      { id: 'pf-front', fill: colors.front, d: faces.front },
      { id: 'pf-top',   fill: colors.top,   d: faces.top },
    ];

    for (const f of faceSpec) {
      let el = svg.querySelector<SVGPathElement>('#' + f.id);
      if (!el) {
        el = document.createElementNS(svgNS, 'path');
        el.id = f.id;
        svg.appendChild(el);
      }
      el.setAttribute('d', f.d);
      el.setAttribute('fill', f.fill);
    }

    /* Wireframe edges (on top of faces) */
    const edgeGroupId = 'pf-edges';
    let edgeG = svg.querySelector<SVGGElement>('#' + edgeGroupId);
    if (!edgeG) {
      edgeG = document.createElementNS(svgNS, 'g');
      edgeG.id = edgeGroupId;
      svg.appendChild(edgeG);
    }
    /* Clear previous edges */
    while (edgeG.firstChild) edgeG.removeChild(edgeG.firstChild);

    for (const e of wf.edges) {
      const line = document.createElementNS(svgNS, 'line');
      line.setAttribute('x1', String(e.from.x));
      line.setAttribute('y1', String(e.from.y));
      line.setAttribute('x2', String(e.to.x));
      line.setAttribute('y2', String(e.to.y));
      if (e.hidden) {
        line.setAttribute('stroke', '#888');
        line.setAttribute('stroke-width', '0.8');
        line.setAttribute('stroke-dasharray', '2,2');
        line.setAttribute('opacity', '0.5');
      } else {
        line.setAttribute('stroke', colors.stroke);
        line.setAttribute('stroke-width', '0.5');
        line.setAttribute('opacity', '0.6');
      }
      edgeG.appendChild(line);
    }
  }

  if (document.readyState === 'complete') {
    buildPedestal();
  } else {
    window.addEventListener('load', buildPedestal);
  }
</script>
