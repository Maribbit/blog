---
// OpenWindow — the window frame + windowsill.
//
// SVG paths live in src/assets/svg/scene/window-frame.svg.
// Imported via ?raw and injected by SvgAsset.
import frameSvg from '../assets/svg/scene/window-frame.svg?raw';
import SvgAsset from './SvgAsset.astro';
---

<div class="window" aria-hidden="true">
  <SvgAsset content={frameSvg} class="window__svg" />
</div>

<style>
  .window {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  :global(.window__svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>