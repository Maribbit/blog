---
// A small stack of books that sits on the windowsill.
// The top book is the interaction trigger (data-nav="reading").
---

<div class="books" aria-hidden="true">
  <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg">
    <!-- Stack base (largest, lying flat) -->
    <rect x="14" y="46" width="172" height="22" fill="#93989a" />
    <rect x="14" y="46" width="172" height="3" fill="#7d8384" />
    <!-- Second book -->
    <rect x="22" y="32" width="156" height="14" fill="#adb3b3" />
    <rect x="22" y="32" width="156" height="2" fill="#8a9090" />
      <!-- Top book (interactive): red spine -->
    <g class="books__top" data-nav="reading" role="button" tabindex="0" aria-label="打开阅读">
      <rect x="32" y="14" width="136" height="18" fill="#94231f" />
      <rect x="32" y="14" width="136" height="2" fill="#6e1a17" />
      <!-- subtle title block on the spine -->
      <rect x="44" y="20" width="60" height="6" fill="#b96259" />
      <rect x="120" y="20" width="40" height="6" fill="#b96259" />
    </g>
  </svg>
</div>

<style>
  .books {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 4px 6px var(--color-shadow));
  }

  .books svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .books__top {
    cursor: pointer;
    transition: transform 0.2s ease;
    transform-box: fill-box;
    transform-origin: center;
  }

  .books__top:hover,
  .books__top:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }
</style>
