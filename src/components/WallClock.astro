---
// Minimal wall clock. Hands are rotated to the live system time by the script.
// Decorative mechanics: a middle gear (three spokes, inward-facing teeth)
// steps clockwise one tooth per second with an escapement motion — a
// locked crawl that releases into an accelerating snap — and an outer
// gear with three spokes steps clockwise at a steady 3° per 100ms.
//
// viewBox 200×200 (center 100,100): the face keeps r=56 while the gear
// assembly wraps it — outer teeth reach r=88. --clock-size in index.astro
// is scaled up (×200/160) so the face renders at nearly the same pixels.
---

<div class="clock" role="img" aria-label="与当前时间同步的时钟">
  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <!-- Middle gear — three spokes + ring with INWARD-facing teeth (an
         internal ring gear: the solid band sits on the outer edge, the
         dashed teeth on the inner edge point at the hub — the opposite
         of the outer gear's outward teeth). Steps clockwise one tooth
         per second with an escapement snap (locked crawl, then
         release); the spokes are covered by the face (drawn later), so
         only the outer half shows. Offset 60° from the outer gear's
         spokes so the two triads interleave. -->
    <g id="gear-middle">
      <circle cx="100" cy="100" r="76" fill="none" stroke="#d5d9db" stroke-width="8" opacity="0.9" />
      <!-- dasharray 5 5.7 at r=70, stroke 7 → inward teeth attached to
           the band's inner edge, pointing at the hub -->
      <circle cx="100" cy="100" r="70" fill="none" stroke="#c2cacd" stroke-width="7" stroke-dasharray="5 5.7" opacity="0.85" />
    </g>

    <!-- Outermost gear + three connecting rods — one rotating assembly.
         The rods run from the central hub out to the ring and are covered
         by the face (drawn below it), so only the portion past the face
         shows. Steps clockwise at a steady 3° per 100ms. -->
    <g id="gear-outer">
      <!-- The three spokes are offset +2.44° (half a tooth width) so
           each spoke passes through the CENTER of a tooth rather than
           its leading edge — a dash at 7.5 of the 23.04-unit pitch
           spans 4.88°, so half is 2.44°. The gear steps 3°/tick, but
           the offset is static and shared, so alignment holds forever. -->
      <rect x="97" y="15" width="6" height="70" rx="2.5" fill="#c7cbcd" opacity="0.9" transform="rotate(2.44 100 100)" />
      <rect x="97" y="15" width="6" height="70" rx="2.5" fill="#c7cbcd" opacity="0.9" transform="rotate(122.44 100 100)" />
      <rect x="97" y="15" width="6" height="70" rx="2.5" fill="#c7cbcd" opacity="0.9" transform="rotate(242.44 100 100)" />
      <circle cx="100" cy="100" r="86" fill="none" stroke="#d5d9db" stroke-width="5" opacity="0.9" />
      <!-- dasharray 7.5 15.54 at r=88 → 24 teeth (pitch 15°) -->
      <circle cx="100" cy="100" r="88" fill="none" stroke="#c2cacd" stroke-width="7" stroke-dasharray="7.5 15.54" opacity="0.85" />
    </g>

    <!-- Round face -->
    <circle cx="100" cy="100" r="56" fill="#eef2f3" stroke="#c2cacd" stroke-width="3" />

    <!-- Hands (sharp rectangles; all pivot at the center 100,100) -->
    <rect id="hand-hour" x="98" y="76" width="4" height="28" fill="#2d3338"
      style="transform-box: view-box; transform-origin: 100px 100px;" />
    <rect id="hand-minute" x="98.8" y="64" width="2.4" height="40" fill="#2d3338"
      style="transform-box: view-box; transform-origin: 100px 100px;" />
    <rect id="hand-second" x="99.4" y="60" width="1.2" height="46" fill="#94231f"
      style="transform-box: view-box; transform-origin: 100px 100px;" />
    <!-- Center hub: a small diamond -->
    <rect x="95" y="95" width="10" height="10" fill="#2d3338"
      style="transform-box: view-box; transform-origin: 100px 100px; transform: rotate(45deg);" />
  </svg>
</div>

<style>
  .clock {
    width: 100%;
    height: 100%;
  }

  .clock svg {
    width: 100%;
    height: 100%;
  }

  /* Gears pivot at the viewBox center — CSS rotation on the <g> keeps
     every tooth in place while the ring swings. */
  #gear-outer,
  #gear-middle {
    transform-box: view-box;
    transform-origin: 100px 100px;
  }
</style>

<script>
  import { register } from '../utils/animation-loop';

  const hour = document.getElementById('hand-hour');
  const minute = document.getElementById('hand-minute');
  const second = document.getElementById('hand-second');
  let lastSec = -1;

  function tick() {
    const now = new Date();
    const s = now.getSeconds();
    const m = now.getMinutes();
    const h = now.getHours() % 12;

    const secDeg = s * 6;
    const minDeg = m * 6 + s * 0.1;
    const hourDeg = h * 30 + m * 0.5;

    if (hour) hour.style.transform = `rotate(${hourDeg}deg)`;
    if (minute) minute.style.transform = `rotate(${minDeg}deg)`;
    if (second) second.style.transform = `rotate(${secDeg}deg)`;
  }

  // Immediate first render, then sync to real seconds via shared rAF loop.
  tick();
  register(() => {
    const s = Math.floor(Date.now() / 1000);
    if (s !== lastSec) {
      lastSec = s;
      tick();
    }
  });

  /* Three independent mechanical motions — all driven by world-clock
     time so they are deterministic across reloads. Decorative only:
     frozen under prefers-reduced-motion so the hands stay the sole
     motion. */
  const gearOuter = document.getElementById('gear-outer');
  const gearMiddle = document.getElementById('gear-middle');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion && gearOuter && gearMiddle) {
    /* Middle gear — escapement stepping: one tooth per second,
       clockwise. A real gear train doesn't sweep — it locks, then
       releases with a snap. Each 1s step is split into
         - a locked phase (~55% of the step): the gear barely creeps
           forward while the train builds torque (slow, reluctant
           motion before the release),
         - a release phase: an accelerating easeIn that snaps the gear
           onto the next tooth.
       The step count comes from the world clock, so the click lands
       on the same boundary as the second hand's tick. */
    const STEP_MS = 1000;  // one step per second
    const DWELL = 0.55;    // locked fraction of each step
    const CREEP = 0.06;    // fraction of a pitch crawled while locked

    /* One tooth pitch of the middle gear's internal ring — derived
       from the dasharray (5 + 5.7 units at r=70), so each step lands
       the teeth exactly back on the painted pattern. ≈8.76°. */
    const TOOTH_PITCH_DEG = (360 * 10.7) / (2 * Math.PI * 70);

    /* Fraction of one pitch covered at local time t ∈ [0,1] within a
       step: a slow linear crawl while locked, then a cubic easeIn —
       slowest right after release, fastest right before landing, like
       a spring letting go. */
    const escapementProgress = (t: number): number => {
      if (t < DWELL) return CREEP * (t / DWELL);
      const u = (t - DWELL) / (1 - DWELL);
      return CREEP + (1 - CREEP) * u * u * u;
    };

    /* Outer ring — clean stepped escapement, no vibration. 24 teeth →
       pitch 15°. Each 100ms tick advances exactly 3° (no overshoot /
       settle wobble); 3 vs the 15° pitch leaves a 12° tooth drift per
       step, so the teeth crawl forward instead of re-aligning (which
       would look frozen). */
    const OUTER_TICK = 100;  // ms per step
    const OUTER_STEP = 1;    // degrees per step (≠ pitch 15°)

    register((time) => {
      /* Middle gear — escapement step. Kept under 360° (the tooth
         pattern is pitch-periodic, so the wrap is invisible) to keep
         the transform string small and exact. */
      const step = Math.floor(time / STEP_MS);
      const t = (time % STEP_MS) / STEP_MS;
      const ang = ((step + escapementProgress(t)) * TOOTH_PITCH_DEG) % 360;
      gearMiddle.style.transform = `rotate(${ang.toFixed(3)}deg)`;

      /* Outer ring — steady 3° step every 100ms, kept under 360° so
         the transform string stays small and exact. */
      const steps = Math.floor(time / OUTER_TICK);
      const angOuter = ((steps % 360) * OUTER_STEP) % 360;
      gearOuter.style.transform = `rotate(${angOuter.toFixed(2)}deg)`;
    });
  }
</script>
