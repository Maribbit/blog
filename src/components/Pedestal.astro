---
// Pedestal — top face (dark gray rounded rectangle) + wireframe reference.
// Add your custom shape inside the rounded top face.
---

<div class="pedestal" id="pedestal" aria-hidden="true">
  <svg
    class="pedestal__svg"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    overflow="visible"
    xmlns="http://www.w3.org/2000/svg"
  ></svg>
</div>

<style>
  .pedestal {
    position: absolute;
    left: 43%;
    top: 21%;
    width: calc(20 * var(--cm));
    height: calc(20 * var(--cm) * 689 / 418);
    transform: translateX(-85%);
    z-index: 25;
    pointer-events: none;
  }

  .pedestal__svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  import { getStageGeom } from '../utils/perspective';
  import { projectCorners, roundedPath, calcScaleBack, calcVpXLocal, calcVpYLocal } from '../utils/cube';

  function buildPedestal() {
    const pedEl = document.getElementById('pedestal');
    if (!pedEl) return;
    const svg = pedEl.querySelector('.pedestal__svg') as unknown as SVGSVGElement;
    if (!svg) return;

    /* ─── Read room geometry ─── */
    const g = getStageGeom();
    const desk = document.querySelector<HTMLElement>('.desk');
    if (!desk) return;

    const pedRect = pedEl.getBoundingClientRect();
    const deskRect = desk.getBoundingClientRect();
    const deskCenterX = deskRect.left + deskRect.width / 2;

    /* ─── Build projection context ─── */
    const CUBE = { cx: 46, hw: 35, topY: 32, botY: 45 };
    const BACK_VB_Y = 2;
    const ctx = {
      vpX: calcVpXLocal(pedRect, deskCenterX),
      vpY: calcVpYLocal(pedRect, g.vpY),
      scaleBack: calcScaleBack(g.vpY, pedRect.top, pedRect.height, CUBE.topY, BACK_VB_Y),
    };

    /* ─── Project ─── */
    const c = projectCorners(CUBE, ctx);

    /* ─── Radii ───
         RF/RB  = top & bottom face corner radius (large → visible pillow)
         WF/WB  = wall connection inset (small → walls hide bottom arc)   */
    const RF = 6;
    const RB = RF * ctx.scaleBack;
    const WF = 4;                          // wall front inset
    const WB = WF * ctx.scaleBack;         // wall back inset
    const S  = '#b0b0b0';

    /* ─── Helpers ─── */
    function path(d: string, fill: string, id: string) {
      let el = svg.querySelector<SVGPathElement>('#' + id);
      if (!el) {
        el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        el.id = id;
        svg.appendChild(el);
      }
      el.setAttribute('d', d);
      el.setAttribute('fill', fill);
    }
    function quad(p1: {x:number,y:number}, p2: {x:number,y:number}, p3: {x:number,y:number}, p4: {x:number,y:number}) {
      return `M ${p1.x} ${p1.y} L ${p2.x} ${p2.y} L ${p3.x} ${p3.y} L ${p4.x} ${p4.y} Z`;
    }
    /* inset a point from p0 along edge p0→p1 by distance r */
    function inset(p0: {x:number,y:number}, p1: {x:number,y:number}, r: number) {
      const dx = p1.x - p0.x, dy = p1.y - p0.y;
      const len = Math.sqrt(dx*dx + dy*dy) || 1;
      return { x: p0.x + (r/len)*dx, y: p0.y + (r/len)*dy };
    }

    /* ─── Compute side-wall corners ───
         Walls connect NEAR the cube corners (inset WF/WB) rather than at
         the arc endpoints (RF/RB). The top/bottom faces (large RF arcs)
         then overhang the walls, creating the pill shape.                */
    const ft = {
      fl: c.fl_top, fr: c.fr_top, bl: c.bl_top, br: c.br_top };
    const fb = {
      fl: c.fl_bot, fr: c.fr_bot, bl: c.bl_bot, br: c.br_bot };

    /* Front wall — inset by WF from cube corners (edges vertical) */
    const fw = {
      tl: inset(ft.fl, ft.fr, WF),
      tr: inset(ft.fr, ft.fl, WF),
      br: inset(fb.fr, fb.fl, WF),
      bl: inset(fb.fl, fb.fr, WF),
    };

    /* Right wall — inset by WF/WB along depth edges */
    const rw = {
      tf: inset(ft.fr, ft.br, WF),
      tb: inset(ft.br, ft.fr, WB),
      bb: inset(fb.br, fb.fr, WB),
      bf: inset(fb.fr, fb.br, WF),
    };

    /* Left wall — inset by WF/WB along depth edges */
    const lw = {
      tf: inset(ft.bl, ft.fl, WB),
      tb: inset(ft.fl, ft.bl, WF),
      bb: inset(fb.fl, fb.bl, WF),
      bf: inset(fb.bl, fb.fl, WB),
    };

    /* ─── Build faces, z-order back→front ─── */
    // 1. Bottom face — rounded rectangle
    path(roundedPath([fb.fl, fb.fr, fb.br, fb.bl], [RF, RF, RB, RB]), S, 'pf-bot');
    // 2. Left side
    path(quad(lw.tf, lw.tb, lw.bb, lw.bf), S, 'pf-left');
    // 3. Right side
    path(quad(rw.tf, rw.tb, rw.bb, rw.bf), S, 'pf-right');
    // 4. Front side — left & right edges VERTICAL (same X)
    path(quad(fw.tl, fw.tr, fw.br, fw.bl), S, 'pf-front');
    // 5. Top face — dark gray, covers all
    path(roundedPath([ft.fl, ft.fr, ft.br, ft.bl], [RF, RF, RB, RB]), '#555', 'pf-top');
  }

  if (document.readyState === 'complete') {
    buildPedestal();
  } else {
    window.addEventListener('load', buildPedestal);
  }
</script>
