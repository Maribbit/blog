---
import Layout from '../layouts/Layout.astro';
import Character from '../components/Character.astro';
import WallClock from '../components/WallClock.astro';
import Overlays from '../components/Overlays.astro';
import OpenWindow from '../components/OpenWindow.astro';
import WindowView from '../components/WindowView.astro';
import Wall from '../components/Wall.astro';
import Desk from '../components/Desk.astro';
---

<Layout title="Maribbit's Blog | 海兔的博客">
  <main class="room" id="room">
    <div class="stage" id="stage">
      <Wall />

      <div class="obj obj--window">
        <div class="window-view-slot">
          <WindowView />
        </div>
        <OpenWindow />
      </div>

      <div
        class="obj obj--character"
        data-nav="about"
        role="button"
        tabindex="0"
        aria-label="关于海兔"
      >
        <div class="contact-shadow contact-shadow--character"></div>
        <Character />
      </div>

      <Desk />
    </div>

    <Overlays />

    <!-- Floating top-center clock — fixed UI chrome, centred below the
         scroll indicator bar. z-index stays under the paper overlays
         (100) so opening a view covers it with the veil like the room. -->
    <div class="clock-float">
      <WallClock />
    </div>

    <!-- ──── Scroll indicator bar ──── -->
    <div class="scroll-bar" id="scroll-bar" aria-hidden="true">
      <div class="scroll-bar__inner" id="scroll-inner">
        <div class="scroll-bar__vp" id="scroll-vp"></div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Re-center the stage horizontally when the stage is wider than the
  // room (narrow viewports). Overlays are position:fixed and unaffected.
  function centerStage() {
    const room = document.getElementById('room');
    const stage = document.getElementById('stage');
    if (!room || !stage) return;
    const overflow = stage.scrollWidth - room.clientWidth;
    room.scrollLeft = overflow > 0 ? overflow / 2 : 0;
    updateScrollBar();
  }

  centerStage();
  window.addEventListener('resize', centerStage);
  requestAnimationFrame(centerStage);

  /* ──── Scroll indicator bar ──── */
  function getRoom(): HTMLElement | null {
    return document.getElementById('room');
  }

  function updateScrollBar() {
    const bar = document.getElementById('scroll-bar');
    const vp = document.getElementById('scroll-vp');
    const room = getRoom();
    if (!bar || !vp || !room) return;
    const overflow = room.scrollWidth - room.clientWidth;
    if (overflow <= 0) {
      bar.classList.remove('is-visible');
      return;
    }
    bar.classList.add('is-visible');
    vp.style.width = ((room.clientWidth / room.scrollWidth) * 100) + '%';
    vp.style.left = ((room.scrollLeft / room.scrollWidth) * 100) + '%';
  }

  const _room2 = getRoom();
  if (_room2) {
    _room2.addEventListener('scroll', updateScrollBar);
  }
  window.addEventListener('resize', updateScrollBar);

  /* ──── Bar: drag to scroll ──── */
  {
    const bar = document.getElementById('scroll-bar');
    if (bar) {
      let dragging = false;
      let startX = 0;
      let startScroll = 0;

      bar.addEventListener('pointerdown', (e) => {
        const room = getRoom();
        if (!room) return;
        const overflow = room.scrollWidth - room.clientWidth;
        if (overflow <= 0) return;
        dragging = true;
        startX = e.clientX;
        startScroll = room.scrollLeft;
        bar.setPointerCapture(e.pointerId);
      });

      bar.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const room = getRoom();
        if (!room) return;
        const dx = e.clientX - startX;
        const barW = bar.clientWidth;
        const scrollable = room.scrollWidth - room.clientWidth;
        room.scrollLeft = startScroll + dx * (scrollable / barW);
      });

      bar.addEventListener('pointerup', () => { dragging = false; });
      bar.addEventListener('pointercancel', () => { dragging = false; });
    }
  }



  /* ─── Desktop: vertical mouse wheel → horizontal scroll ───
     On touch devices the native horizontal scroll works fine (the
     room already has overflow-x: auto).  On desktop, intercept the
     wheel event and translate deltaY (and deltaX) into scrollLeft
     movement, so users can scroll the room vertically as expected. */
  if (!('ontouchstart' in window) && navigator.maxTouchPoints === 0) {
    const room = document.getElementById('room');
    if (room) {
      room.addEventListener('wheel', (e) => {
        // Skip when the wheel event is inside an open overlay
        const target = e.target as HTMLElement;
        if (target?.closest?.('.paper[data-open="true"]')) return;

        // Only handle if the stage is wider than the viewport
        const stage = document.getElementById('stage');
        if (!stage || stage.scrollWidth <= room.clientWidth) return;

        const amount = e.deltaX + e.deltaY;
        room.scrollLeft += amount;
        e.preventDefault();
      }, { passive: false });
    }
  }
</script>

<style>
  /*
    Stage scale system
    ==================
    One variable set on .room drives every object. Ratios are fixed; no
    element depends on viewport width directly.

    - char-h scales with viewport HEIGHT so the window always fits with
      a small top margin. No cap — scene always fills vertically.
    - Stage width: max(100%, win-w × 1.8). The desk is 1.15 × win-w and
      is the widest object on stage. The extension platform adds ~7%
      perspective overhang each side. On 1920+ wide screens the visible
      breathing room (viewport − desk) is fully on-screen with a small
      scroll range; on very wide screens the stage caps at the viewport
      width. On narrow viewports the stage is wider than the room and
      .room scrolls horizontally — the wall extends past the visible
      area.
    - Stage is centered with margin: 0 auto so the character is centered
      on wide viewports too (where there's no scroll overflow to push
      it back into the middle).
    - Window bottom (sill front) lands on the character's wrist.
    - Frame aspect 1786/964 is never broken.

    Geometry constants:
      character canvas     453 × 1380
      wrist-from-bottom    1 − 693.478/1380 ≈ 0.4975
      window aspect        1786 / 964
      window-to-char ratio 1.55 × 964/1786 ≈ 0.8366
      vertical span        win-h/char-h + wrist-from-bottom
                           = 0.8366 + 0.4975 = 1.3341
      desk width           1.15 × win-w
      vp horizon           computed per perspective.ts from sill ratio
  */
  .room {
    --win-top-margin: 104px;
    --char-h: calc((100dvh - var(--win-top-margin)) / 1.3341);
    --char-w: calc(var(--char-h) * 453 / 1380);
    --char-wrist-from-bottom: 0.4975;

    --win-scale: calc(var(--char-h) * 1.55);
    --win-w: var(--win-scale);
    --win-h: calc(var(--win-scale) * 964 / 1786);

    /* Desk is wider than the window (1.15×win-w), so the stage must
       be at least that wide. The extension platform adds ~7% visible
       overhang on each side (perspective widening). 1.8× keeps the
       desk centered with visible breathing room on 1920+ screens: the
       visible gutter is set by (viewport − desk) once the stage is
       wider than the viewport, and on very wide screens max() caps
       the stage at 100%. */
    --desk-w: calc(var(--win-w) * 1.15);
    --stage-w: max(100%, calc(var(--win-w) * 1.8));

    /* Scene scale: 1cm in CSS pixels, derived from the character's
       fictional height (170cm) mapped to --char-h. Any prop with a
       known real-world size can be sized with calc(N * var(--cm)). */
    --cm: calc(var(--char-h) / 170);

    /* Perspective math (VP, narrowing, sea horizon) lives in
       src/utils/perspective.ts — runtime JS, not CSS calc. */
    --clock-size: calc(var(--win-w) * 0.072);

    position: fixed;
    inset: 0;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .room::-webkit-scrollbar {
    display: none;
  }

  /* ──── Scroll indicator bar ──── */
  .scroll-bar {
    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(90%, 200px);
    height: 6px;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: rgba(160, 168, 172, 0.35);
  }

  .scroll-bar.is-visible {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }

  /* Hide the top scroll bar while an overlay (about / music / codex)
     is open — it would otherwise float above the overlay's sheet. */
  body[data-overlay='open'] .scroll-bar {
    opacity: 0;
    pointer-events: none;
  }

  .scroll-bar__inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Viewport indicator */
  .scroll-bar__vp {
    position: absolute;
    top: 0;
    height: 100%;
    background: rgba(45, 51, 56, 0.2);
    border-right: 1px solid rgba(45, 51, 56, 0.3);
    border-left: 1px solid rgba(45, 51, 56, 0.3);
  }

  .stage {
    position: relative;
    width: var(--stage-w);
    height: 100%;
    min-height: 100%;
    /* Center the stage horizontally when the room is wider than the
       stage (e.g. very wide viewports). The .room scroll handles the
       narrow-viewport case via centerStage(). */
    margin: 0 auto;
  }

  .obj {
    position: absolute;
  }

  /*
    Window
    Width and height both come from --win-scale, preserving 1786/964.
    top is computed so the sill front lands on the character's wrist:
      wrist y  = 100dvh - char_h × 0.4975
      top      = wrist y - win_h
  */
  .obj--window {
    left: 50%;
    top: calc(
      100dvh
      - var(--char-h) * var(--char-wrist-from-bottom)
      - var(--win-h)
    );
    width: var(--win-w);
    height: var(--win-h);
    transform: translateX(-50%);
    z-index: 5;
    overflow: visible;
  }

  /* Scenery slot. Glass opening in frame coords (viewBox 1786×964):
       x 56..1731 → left 3.14%, width 93.79%
       y 45..880  → top 4.67%,  height 86.62% */
  .window-view-slot {
    position: absolute;
    left: 3.14%;
    top: 4.67%;
    width: 93.79%;
    height: 86.62%;
    overflow: hidden;
    z-index: -1;
  }

  /* Floating top-center clock — fixed UI chrome aligned with the
     scroll indicator bar above it (the bar is 6px tall at top: 0, so
     the clock sits 8px below it). z-index below the paper overlays
     (100): opening a view covers the clock with the veil like the rest
     of the room, so no explicit hide rule is needed. */
  .clock-float {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: var(--clock-size);
    height: var(--clock-size);
    z-index: 50;
  }



  /* Character: feet on the bottom edge, centered horizontally. */
  .obj--character {
    left: 50%;
    bottom: 0;
    width: var(--char-w);
    height: var(--char-h);
    transform: translateX(-50%);
    z-index: 20;
    cursor: pointer;
  }

  .contact-shadow {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at center,
      var(--color-shadow) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .contact-shadow--character {
    bottom: 0.8%;
    width: 46%;
    height: 4%;
  }
</style>
