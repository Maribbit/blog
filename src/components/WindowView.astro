---
// WindowView — the scene visible through the open window.
//
// Layer stack (bottom → top):
//   1. Back SVG   — sky gradient + far-sea gradient rect
//   2. Sea canvas — plain HTML <canvas> (no foreignObject: iOS Safari
//                   does not reliably render HTML inside foreignObject,
//                   especially under a transformed ancestor, and it can
//                   break the whole SVG subtree on WebKit)
//   3. Front SVG  — clouds + islands
//
// All three layers share the same viewBox (1698×835); the canvas uses
// object-fit:cover which is the exact same scale/crop math as the SVGs'
// preserveAspectRatio="xMidYMid slice", so every feature stays aligned.
---

<div class="window-view" aria-hidden="true">
  <!-- Back SVG: sky + far-sea gradient + (SVG sea fallback) -->
  <svg
    class="window-view__svg window-view__svg--back"
    viewBox="0 0 1698 835"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Sky gradient -->
      <linearGradient id="SkyGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#d5d7db" />
        <stop offset="1" stop-color="#e6e6e6" />
      </linearGradient>

      <!-- Base sea gradient (stops filled by src/utils/sea.ts) -->
      <linearGradient id="BaseSeaGradient" x1="0" y1="0" x2="0" y2="1">
        <stop id="grad-stop-far" offset="0%" />
        <stop id="grad-stop-mid" offset="5%" />
        <stop id="grad-stop-near" offset="100%" />
      </linearGradient>
    </defs>

    <!-- Sky: fills entire viewBox -->
    <rect
      id="Sky"
      x="0"
      y="0"
      width="1698"
      height="835"
      fill="url(#SkyGradient)"
    />

    <!-- Base sea gradient rect (re-positioned by sea.ts SVG path only) -->
    <rect
      id="base-sea-rect"
      x="0"
      y="452"
      width="1698"
      height="383"
      fill="url(#BaseSeaGradient)"
    />

    <!-- Ocean SVG fallback layers (empty when canvas renderer is used) -->
    <g id="sea-layers"></g>
  </svg>

  <!-- Sea canvas host — plain HTML, sits between the back and front SVGs -->
  <div id="sea-canvas-host" class="window-view__sea"></div>

  <!-- Front SVG: clouds + islands + lighthouse -->
  <svg
    class="window-view__svg window-view__svg--front"
    viewBox="0 0 1698 835"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g id="cloud-layer"></g>
    <g id="ship-layer"></g>
    <g id="island-layer"></g>
  </svg>
</div>

<style>
  .window-view {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Each SVG layer fills the slot and crops like the original single
     SVG did (xMidYMid slice). */
  .window-view__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
  }
  .window-view__svg--back {
    z-index: 1;
  }

  /* Sea canvas host: opaque HTML layer between back and front SVGs. */
  .window-view__sea {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .window-view__sea canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* same scale/crop as the SVGs' slice */
    display: block;
    pointer-events: none;
  }

  .window-view__svg--front {
    z-index: 3;
  }
</style>

<script>
  import { getStageGeom, vpYtoWindowViewY } from '../utils/perspective';
  import { buildOcean } from '../utils/sea';
  import { buildClouds } from '../utils/clouds';
  import { buildIslands } from '../utils/islands';
  import { buildShips } from '../utils/ships';

  const VIEW_W = 1698;
  const VIEW_H = 835;

  /* ─── Vanishing-point driven sea horizon ─── */
  let seaTopY = 452;
  try {
    const geom = getStageGeom();
    seaTopY = vpYtoWindowViewY(geom.vpY, geom);
  } catch { /* stage not ready — use fallback */ }

  /* ─── Build sea (Canvas renderer, 1 layer instead of 21 SVG paths) ─── */
  const seaContainer = document.getElementById('sea-canvas-host');
  const { animate: seaAnimate } = seaContainer
    ? buildOcean(seaContainer as unknown as HTMLElement, { viewWidth: VIEW_W, viewHeight: VIEW_H, seaTopY })
    : { animate: () => {} };

  /* ─── Build clouds (GPU-composited drift) ─── */
  const cloudContainer = document.getElementById('cloud-layer') as unknown as SVGGElement;
  const { update: cloudUpdate } = cloudContainer
    ? buildClouds(cloudContainer, { viewWidth: VIEW_W, viewHeight: VIEW_H })
    : { update: () => {} };

  /* ─── Build islands ─── */
  const islandContainer = document.getElementById('island-layer') as unknown as SVGGElement;
  if (islandContainer) {
    buildIslands(islandContainer, { viewWidth: VIEW_W, viewHeight: VIEW_H, seaTopY });
  }

  /* ─── Build distant ships ─── */
  const shipContainer = document.getElementById('ship-layer') as unknown as SVGGElement;
  const { update: shipUpdate } = shipContainer
    ? buildShips(shipContainer, { viewWidth: VIEW_W })
    : { update: () => {} };

  /* ─── Shared animation loop — world-clock time (ms) ───
     Every callback receives the same deterministic world time, so
     clouds/ships/sea all resume exactly where they were on refresh. */
  import { register } from '../utils/animation-loop';
  register((timeMs) => {
    /* Sea animates at its historical rate (0.02/frame ≈ 1.2/s). */
    seaAnimate((timeMs / 1000) * 1.2);
    cloudUpdate(timeMs);
    shipUpdate(timeMs);
  });
</script>
